# ===========================================
# SmartHotel Environment Variables Template
# ===========================================
# Copy this file to .env.local and update with your values

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/smarthotel

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Social Providers
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
FACEBOOK_CLIENT_ID=your-facebook-client-id
FACEBOOK_CLIENT_SECRET=your-facebook-client-secret

# Stripe Payment Configuration (Test Mode)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Email Configuration (SMTP)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM_EMAIL=noreply@smarthotel.com
SMTP_FROM_NAME=SmartHotel

# Socket.IO Configuration
SOCKET_IO_URL=http://localhost:3000

# Application Configuration
NODE_ENV=development

# Demo Mode: set to 'true' ONLY for non-production demo deployments.
# Controls whether the credential quick-fill panel is shown on the signin page.
# WARNING: Never set to 'true' in production — credential strings are excluded
# from the JS bundle when this is absent or false.
NEXT_PUBLIC_DEMO_MODE=false

# Redis / Upstash Rate Limiting & Caching
UPSTASH_REDIS_REST_URL=your-upstash-redis-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# Rate Limiting: Trusted Reverse Proxy IPs (comma-separated)
# Only X-Forwarded-For headers from these IPs will be trusted for client identification.
# Set to the egress IP(s) of your Cloudflare/AWS ALB/nginx proxy in production.
# Example: TRUSTED_PROXY_IPS=10.0.0.1,172.31.0.0
TRUSTED_PROXY_IPS=


# External OTA Integrations
BOOKING_COM_API_KEY=your_booking_com_api_key
BOOKING_COM_PARTNER_ID=your_partner_id
BOOKING_COM_MACHINE_ACCOUNT=your_machine_account
