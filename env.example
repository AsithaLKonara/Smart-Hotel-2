# ============================================================
# SmartHotel — Environment Variables Reference
# ============================================================
# Copy this file to .env.local and populate with your values.
# Run `npm run validate:env` to confirm readiness before starting.
# See docs/archive/ALL_REQUIRED_ENV_VARIABLES.md for full reference.
# ============================================================

# ------------------------------------------------------------
# REQUIRED — Application will NOT start without these
# ------------------------------------------------------------

# Database (PostgreSQL via Supabase, Neon, or on-prem)
# NOTE: This project uses PostgreSQL exclusively via Prisma.
# MongoDB is NOT supported. Use the postgresql:// or postgres:// prefix.
DATABASE_URL="postgresql://username:password@localhost:5432/smarthotel"
DIRECT_URL="postgresql://username:password@localhost:5432/smarthotel"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-here-minimum-32-characters"
NEXTAUTH_URL="https://smarthotel-demo.vercel.app"

# ------------------------------------------------------------
# SECURITY — Required for authenticated system operations
# ------------------------------------------------------------

# Cron job secret — ALL cron routes authenticate via Bearer token.
# MUST be set in production. Without it, the Night Audit cron will
# reject all requests with 500 (fail-closed by design — CFG-004).
CRON_SECRET="generate-a-strong-random-secret-here"

# Stripe (Payment processing)
STRIPE_SECRET_KEY="sk_test_your-stripe-secret-key-here"
STRIPE_PUBLISHABLE_KEY="pk_test_your-stripe-publishable-key-here"
STRIPE_WEBHOOK_SECRET="whsec_your-stripe-webhook-secret-here"

# ------------------------------------------------------------
# REDIS — Required for distributed locking & deduplication
# ------------------------------------------------------------

# Upstash Redis (Used for: distributed booking locks, Stripe webhook
# deduplication, chat history queue, and outbox drain triggers)
# The application fails closed (HTTP 503) if Redis is unavailable
# during critical operations.
UPSTASH_REDIS_REST_URL="https://your-upstash-redis-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-token"

# ------------------------------------------------------------
# EMAIL (SMTP) — Required for transactional mail via Outbox pattern
# ------------------------------------------------------------

SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM_EMAIL="noreply@smarthotel.com"
SMTP_FROM_NAME="SmartHotel"
ADMIN_EMAIL="admin@smarthotel.com"
CONTACT_EMAIL="concierge@smarthotel.com"

# ------------------------------------------------------------
# AI / CHAT — Required for Groq-powered concierge chatbot
# ------------------------------------------------------------

# Groq API Key — No fallback. If absent, chat endpoint will
# return a graceful static response (CFG-004 compliance).
GROQ_API_KEY="gsk_your-groq-api-key-here"

# ------------------------------------------------------------
# OTA INTEGRATIONS — Required for Booking.com channel sync
# ------------------------------------------------------------

# Booking.com OTA sync credentials
BOOKING_COM_API_KEY="your-booking-com-api-key"
BOOKING_COM_PARTNER_ID="your-booking-com-partner-id"

# Webhook secret for authenticating inbound OTA push notifications.
# Requests that do not present this token as a Bearer are rejected (401).
BOOKING_COM_WEBHOOK_SECRET="your-booking-com-webhook-secret"

# ------------------------------------------------------------
# REAL-TIME (Pusher) — Optional. System boots without these.
# ------------------------------------------------------------
# If absent, real-time dashboard events are silently no-ops.
# See lib/realtime.ts for graceful-degradation behavior (CFG-003).
PUSHER_APP_ID="your-pusher-app-id"
NEXT_PUBLIC_PUSHER_KEY="your-pusher-key"
PUSHER_SECRET="your-pusher-secret"
NEXT_PUBLIC_PUSHER_CLUSTER="mt1"

# ------------------------------------------------------------
# GOOGLE SERVICES — Optional
# ------------------------------------------------------------

GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_MAPS_API_KEY="AIzaSyYour_Google_Maps_API_Key_Here"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="AIzaSyYour_Google_Maps_API_Key_Here"
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# ------------------------------------------------------------
# CLOUDINARY — Optional (image uploads)
# ------------------------------------------------------------

CLOUDINARY_CLOUD_NAME="your-cloud-name-here"
CLOUDINARY_API_KEY="your-cloudinary-api-key-here"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret-here"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name-here"

# ------------------------------------------------------------
# PUSH NOTIFICATIONS — Optional
# ------------------------------------------------------------

NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key-here"
VAPID_PRIVATE_KEY="your-vapid-private-key-here"

# ------------------------------------------------------------
# SECURITY & OPERATIONAL FLAGS
# ------------------------------------------------------------

RATE_LIMIT_ENABLED="true"
MAX_LOGIN_ATTEMPTS="5"
LOGIN_TIMEOUT_MINUTES="15"
SESSION_TIMEOUT_HOURS="8"
ENABLE_CSP="true"
ENABLE_HSTS="true"
TRUST_PROXY="true"
HEALTH_CHECK_ENABLED="true"
HEALTH_CHECK_TIMEOUT="5000"

# Error Monitoring — Optional
SENTRY_DSN="your-sentry-dsn-here"
NEXT_PUBLIC_SENTRY_DSN="your-sentry-dsn-here"

# Security Scanning — Optional
SNYK_TOKEN="your-snyk-token"

# Public-facing app URL (used in email templates, metadata)
NEXT_PUBLIC_APP_URL="https://smarthotel.example.com"