# Database (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/smarthotel"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-here-minimum-32-characters"
NEXTAUTH_URL="https://smarthotel-demo.vercel.app"

# Stripe (Optional - for payment processing)
STRIPE_SECRET_KEY="sk_test_your-stripe-secret-key-here"
STRIPE_PUBLISHABLE_KEY="pk_test_your-stripe-publishable-key-here"
STRIPE_WEBHOOK_SECRET="whsec_your-stripe-webhook-secret-here"

# Email (Optional - for password reset and notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
ADMIN_EMAIL="admin@smarthotel.com"

# Google OAuth (Optional - for social authentication)
GOOGLE_CLIENT_ID="your-google-client-id-here"
GOOGLE_CLIENT_SECRET="your-google-client-secret-here"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id-here"

# Google Maps (Optional - for location display)
GOOGLE_MAPS_API_KEY="AIzaSyYour_Google_Maps_API_Key_Here"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="AIzaSyYour_Google_Maps_API_Key_Here"

# Google Analytics (Optional - for tracking)
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Cloudinary (Optional - for image uploads)
CLOUDINARY_CLOUD_NAME="your-cloud-name-here"
CLOUDINARY_API_KEY="your-cloudinary-api-key-here"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret-here"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name-here"

# Push Notifications VAPID Keys (Optional - for background push notifications)
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key-here"
VAPID_PRIVATE_KEY="your-vapid-private-key-here"

# WebSocket Server (Optional - for real-time updates)
# If using cloud service like Pusher or Ably, add their keys here
# PUSHER_APP_ID="your-pusher-app-id"
# PUSHER_KEY="your-pusher-key"
# PUSHER_SECRET="your-pusher-secret"
# PUSHER_CLUSTER="your-pusher-cluster"

# Security
RATE_LIMIT_ENABLED="true"
MAX_LOGIN_ATTEMPTS="5"
LOGIN_TIMEOUT_MINUTES="15"
SESSION_TIMEOUT_HOURS="8"

# Production Security
ENABLE_CSP="true"
ENABLE_HSTS="true"
TRUST_PROXY="true"

# Health Check
HEALTH_CHECK_ENABLED="true"
HEALTH_CHECK_TIMEOUT="5000"

# Error Monitoring (Sentry) - Optional
SENTRY_DSN="your-sentry-dsn-here"
NEXT_PUBLIC_SENTRY_DSN="your-sentry-dsn-here"

# Security Scanning - Optional
SNYK_TOKEN="your-snyk-token"