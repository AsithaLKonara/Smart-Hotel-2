# Test Environment Variables
NODE_ENV=test

# Database
DATABASE_URL="mongodb://localhost:27017/smarthotel_test"

# Authentication
NEXTAUTH_SECRET="test-secret-key-for-testing-only"
NEXTAUTH_URL="http://localhost:3000"

# Stripe (Test Keys)
STRIPE_SECRET_KEY="sk_test_fake_key_for_testing"
STRIPE_PUBLISHABLE_KEY="pk_test_fake_key_for_testing"
STRIPE_WEBHOOK_SECRET="whsec_test_fake_secret"

# Email (Test Configuration)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER="test@smarthotel.test"
SMTP_PASS="test-password"
ADMIN_EMAIL="admin@smarthotel.test"

# Cloudinary (Test Configuration)
CLOUDINARY_CLOUD_NAME="test-cloud"
CLOUDINARY_API_KEY="test-api-key"
CLOUDINARY_API_SECRET="test-api-secret"

# Redis (Test Configuration)
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD="test-password"

# Security
RATE_LIMIT_ENABLED=true
MAX_LOGIN_ATTEMPTS=5
LOGIN_TIMEOUT_MINUTES=15
SESSION_TIMEOUT_HOURS=8

# Monitoring
SENTRY_DSN=""
CRONITOR_API_KEY="test-key"
SNYK_TOKEN="test-token"

# Features
ENABLE_CSP=true
ENABLE_HSTS=true
TRUST_PROXY=false
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_TIMEOUT=5000
CRON_SECRET="test-cron-secret"
