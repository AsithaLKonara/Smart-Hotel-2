{
  "name": "smarthotel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=unit --runInBand --coverage --coverageDirectory=coverage/unit --coverageReporters=lcov",
    "test:integration": "jest --testPathPattern=integration --runInBand --coverage --coverageDirectory=coverage/integration --coverageReporters=lcov",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:production": "BASE_URL=https://smarthotel-demo.vercel.app playwright test tests/e2e/comprehensive-production.spec.ts --project=chromium",
    "test:e2e:local": "BASE_URL=http://localhost:3000 playwright test",
    "test:e2e:comprehensive": "node scripts/run-comprehensive-e2e.js",
    "test:e2e:all": "npm run test:e2e:production && npm run test:e2e:local",
    "test:load": "k6 run tests/k6/booking-load-test.js",
    "test:load:api": "k6 run tests/k6/api-load-test.js",
    "test:load:all": "k6 run tests/k6/booking-load-test.js && k6 run tests/k6/api-load-test.js",
    "test:a11y": "playwright test --grep @a11y",
    "test:security": "snyk test",
    "test:all": "npm run test && npm run test:e2e",
    "test:auth": "node scripts/test-auth.js",
    "test:production": "BASE_URL=https://smarthotel-demo.vercel.app node scripts/test-auth.js",
    "setup:vercel": "node scripts/setup-vercel-env.js",
    "setup:vercel:envs": "node scripts/setup-vercel-envs.js",
    "deploy:vercel": "vercel --prod",
    "deploy:vercel:setup": "./scripts/deploy-vercel.sh",
    "setup:demo": "node scripts/setup-demo-env.js",
    "setup:demo:credentials": "node scripts/setup-demo-credentials.js",
    "validate:env": "node scripts/validate-env.js",
    "validate:env:production": "node scripts/validate-env.js --production",
    "db:seed:production": "tsx prisma/seed-production.ts",
    "db:test": "node scripts/quick-db-test.js",
    "db:debug": "node scripts/debug-db-connection.js",
    "db:test:comprehensive": "node scripts/test-db-comprehensive.js",
    "db:test:production": "BASE_URL=https://smarthotel-demo.vercel.app node scripts/test-db-comprehensive.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:apply-indexes": "node scripts/apply-database-indexes.js",
    "db:apply-indexes:production": "node scripts/apply-indexes-production.js",
    "db:apply-indexes:simple": "node scripts/apply-indexes-simple.js",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "tsx prisma/seed-comprehensive.ts",
    "db:setup:production": "node scripts/setup-production-database.js",
    "db:studio": "prisma studio",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma db push --accept-data-loss",
    "db:migrate:create": "prisma migrate dev --create-only --name",
    "db:migrate:status": "prisma migrate status",
    "security:audit": "npm audit --audit-level=moderate",
    "security:audit:fix": "npm audit fix",
    "security:secrets": "tsx -e \"import('./lib/secrets').then(m => m.validateSecrets())\"",
    "security:scan": "npm run security:audit && npm run security:secrets",
    "security:check": "node scripts/security-audit.js",
    "health:check": "curl -f http://localhost:3000/api/health/live && curl -f http://localhost:3000/api/health/ready",
    "performance:audit": "node scripts/lighthouse-audit.js",
    "performance:audit:mobile": "node scripts/lighthouse-audit.js --mobile-only",
    "performance:bundle": "npm run build && npx @next/bundle-analyzer",
    "performance:analyze": "npm run performance:bundle && npm run performance:audit",
    "production:build": "npm run security:scan && npm run type-check && npm run lint && npm run validate:env:production && npm run build",
    "production:deploy": "npm run production:build && node scripts/run-migrations.js && npm start"
  },
  "dependencies": {
    "@faker-js/faker": "^10.1.0",
    "@hookform/resolvers": "^3.3.2",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.7.1",
    "@stripe/stripe-js": "^2.4.0",
    "@tanstack/react-query": "^5.8.4",
    "@types/qrcode": "^1.5.5",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "bson": "^7.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "critters": "^0.0.23",
    "date-fns": "^2.30.0",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "framer-motion": "^10.18.0",
    "lucide-react": "^0.294.0",
    "multer": "^1.4.5-lts.1",
    "next": "^15.5.7",
    "next-auth": "^4.24.5",
    "next-themes": "^0.2.1",
    "nodemailer": "^7.0.10",
    "pdfkit": "^0.13.0",
    "prisma": "^5.7.1",
    "qrcode": "^1.5.4",
    "react": "^18",
    "react-datepicker": "^4.25.0",
    "react-dom": "^18",
    "react-hook-form": "^7.48.2",
    "react-hot-toast": "^2.4.1",
    "react-query": "^3.39.3",
    "recharts": "^2.8.0",
    "sharp": "^0.33.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "stripe": "^14.10.0",
    "tailwind-merge": "^2.0.0",
    "web-vitals": "^5.1.0",
    "winston": "^3.18.3",
    "yet-another-react-lightbox": "^3.4.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@next/bundle-analyzer": "^16.0.1",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.11",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.19",
    "@types/pdfkit": "^0.17.3",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/supertest": "^6.0.3",
    "autoprefixer": "^10.0.1",
    "chrome-launcher": "^0.15.2",
    "eslint": "^8",
    "eslint-config-next": "14.0.4",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.1.2",
    "lighthouse": "^12.8.2",
    "mongodb-memory-server": "^10.2.1",
    "msw": "^2.11.2",
    "nyc": "^15.1.0",
    "playwright": "^1.56.1",
    "postcss": "^8",
    "snyk": "^1.1299.0",
    "supertest": "^7.1.4",
    "tailwindcss": "^3.3.0",
    "ts-jest": "^29.4.3",
    "tsx": "^4.6.0",
    "typescript": "^5",
    "webpack-bundle-analyzer": "^4.10.2"
  }
}
