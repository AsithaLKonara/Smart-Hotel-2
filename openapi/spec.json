{
  "openapi": "3.0.3",
  "info": {
    "title": "SmartHotel OS Enterprise API Catalog",
    "description": "Standardized REST API specifications, query parameters, payload models, and RBAC requirements for the SmartHotel OS hospitality platform.",
    "version": "1.0.0",
    "contact": {
      "name": "SmartHotel Operations Engineering Team",
      "email": "engineering@smarthotel.com"
    }
  },
  "servers": [
    {
      "url": "/api",
      "description": "Local / Production relative root path"
    }
  ],
  "paths": {
    "/bookings": {
      "get": {
        "summary": "Retrieve Reservation Portfolios",
        "description": "Returns list of active bookings filtered by status or check-in boundaries. For guests, results are constrained to their authenticated user identifier.",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "userId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success payload listing matching room bookings.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingsArray"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized access attempt"
          }
        }
      },
      "post": {
        "summary": "Create Room Reservation",
        "description": "Acquires room-specific concurrency lock, performs atomic date overlap validation, and issues a standard booking transaction.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Unique UUID to protect against transaction double-creation and retry storms."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookingPayload"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Booking processed. Details returned with generated invoice and Stripe payload if pay_now mode active.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingResponse"
                }
              }
            }
          },
          "400": {
            "description": "Payload constraint check failed (validation error)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ZodValidationError"
                }
              }
            }
          },
          "409": {
            "description": "Conflict: Room double booked or concurrency lock active."
          }
        }
      }
    },
    "/payments": {
      "post": {
        "summary": "Submit Stripe Payment Capture",
        "description": "Registers credit-card payment captures, writes double-entry ledger entries, and initiates cash drawer summaries.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaymentPayload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Payment completed. Cash accounts debited, guest receivables credited."
          },
          "402": {
            "description": "Payment processing declined by Stripe terminal."
          }
        }
      }
    },
    "/rooms": {
      "get": {
        "summary": "Retrieve Rooms List",
        "description": "Returns a list of rooms. Unauthenticated requests receive the RoomPublic schema, omitting operational fields.",
        "responses": {
          "200": {
            "description": "List of rooms",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "rooms": {
                      "type": "array",
                      "items": {
                        "oneOf": [
                          {
                            "$ref": "#/components/schemas/RoomPublic"
                          },
                          {
                            "$ref": "#/components/schemas/RoomInternal"
                          }
                        ]
                      }
                    },
                    "count": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/rooms/{id}": {
      "get": {
        "summary": "Retrieve Room Details",
        "description": "Returns details of a specific room. Unauthenticated requests receive the RoomPublic schema.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Room details",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/RoomPublic"
                    },
                    {
                      "$ref": "#/components/schemas/RoomInternal"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/complaints": {
      "get": {
        "summary": "Retrieve Complaints",
        "description": "Returns a list of complaints. Non-admins only receive their own complaints. Admins can filter by userId.",
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Filter by userId (admin only)"
          }
        ],
        "responses": {
          "200": {
            "description": "List of complaints",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Complaint"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a Complaint",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateComplaintRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Complaint created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Complaint"
                }
              }
            }
          },
          "400": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ZodValidationError"
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Update a Complaint",
        "description": "Admin only endpoint to update complaint status.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateComplaintRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Complaint updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Complaint"
                }
              }
            }
          },
          "400": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ZodValidationError"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Must be an admin"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "NextAuthCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "next-auth.session-token"
      },
      "BearerToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "BookingPayload": {
        "type": "object",
        "required": [
          "roomId",
          "checkIn",
          "checkOut",
          "guests"
        ],
        "properties": {
          "roomId": {
            "type": "string",
            "description": "Valid MongoDB ObjectId"
          },
          "checkIn": {
            "type": "string",
            "format": "date",
            "example": "2026-05-10"
          },
          "checkOut": {
            "type": "string",
            "format": "date",
            "example": "2026-05-15"
          },
          "guests": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "specialRequests": {
            "type": "string"
          },
          "paymentMethod": {
            "type": "string",
            "enum": [
              "pay_now",
              "pay_later"
            ]
          }
        }
      },
      "BookingResponse": {
        "type": "object",
        "properties": {
          "booking": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "roomId": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "totalAmount": {
                "type": "number"
              },
              "confirmationCode": {
                "type": "string"
              },
              "invoice": {
                "type": "object"
              }
            }
          }
        }
      },
      "PaymentPayload": {
        "type": "object",
        "required": [
          "amount",
          "paymentMethod",
          "userId"
        ],
        "properties": {
          "bookingId": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "paymentMethod": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          }
        }
      },
      "BookingsArray": {
        "type": "object",
        "properties": {
          "bookings": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "ZodValidationError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "Validation error"
          },
          "details": {
            "type": "object",
            "description": "Zod-formatted error details object."
          }
        }
      },
      "RoomPublic": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "number": {
            "type": "string"
          },
          "floor": {
            "type": "integer"
          },
          "capacity": {
            "type": "integer"
          },
          "size": {
            "type": "integer"
          },
          "roomTypeId": {
            "type": "string"
          },
          "propertyId": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RoomInternal": {
        "allOf": [
          {
            "$ref": "#/components/schemas/RoomPublic"
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "type": "string"
              },
              "lastStatusChangeAt": {
                "type": "string",
                "format": "date-time"
              },
              "lockId": {
                "type": "string"
              },
              "lockExpiresAt": {
                "type": "string",
                "format": "date-time"
              },
              "lastCleanedAt": {
                "type": "string",
                "format": "date-time"
              },
              "lastInspectedAt": {
                "type": "string",
                "format": "date-time"
              },
              "deletedAt": {
                "type": "string",
                "format": "date-time"
              },
              "version": {
                "type": "integer"
              },
              "ownerId": {
                "type": "string"
              }
            }
          }
        ]
      },
      "Complaint": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "subject": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "URGENT"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "OPEN",
              "IN_PROGRESS",
              "RESOLVED",
              "CLOSED"
            ]
          },
          "bookingId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "resolvedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "CreateComplaintRequest": {
        "type": "object",
        "required": [
          "subject",
          "description",
          "category"
        ],
        "properties": {
          "subject": {
            "type": "string",
            "minLength": 3,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "minLength": 10
          },
          "category": {
            "type": "string",
            "minLength": 2
          },
          "bookingId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "priority": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "URGENT"
            ]
          }
        }
      },
      "UpdateComplaintRequest": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "OPEN",
              "IN_PROGRESS",
              "RESOLVED",
              "CLOSED"
            ]
          },
          "resolvedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      }
    }
  }
}