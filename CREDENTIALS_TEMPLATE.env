# ===========================================
# SmartHotel Demo Credentials Template
# ===========================================
# Copy this file to .env.local and fill in your actual credentials
# Follow instructions in GET_CREDENTIALS_NOW.md

# ===========================================
# Database Configuration (MongoDB Atlas)
# ===========================================
# Get FREE tier at: https://www.mongodb.com/cloud/atlas/register
# After creating cluster, get connection string and replace below
DATABASE_URL=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/smarthotel?retryWrites=true&w=majority

# ===========================================
# NextAuth Configuration
# ===========================================
# Auto-generated by setup script, but verify it exists
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=YOUR_GENERATED_SECRET_HERE

# ===========================================
# Email Configuration (Mailtrap)
# ===========================================
# Get FREE account at: https://mailtrap.io
# 1. Sign up → Email Testing → Inboxes → Copy SMTP credentials
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=YOUR_MAILTRAP_USERNAME_HERE
SMTP_PASS=YOUR_MAILTRAP_PASSWORD_HERE
SMTP_FROM_EMAIL=noreply@smarthotel.com
SMTP_FROM_NAME=SmartHotel Demo
ADMIN_EMAIL=admin@smarthotel.com

# ===========================================
# Stripe Payment Configuration (Test Mode)
# ===========================================
# Get FREE test account at: https://stripe.com
# 1. Sign up → Developers → API keys (TEST mode)
# 2. Copy test keys (sk_test_... and pk_test_...)
STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY_HERE
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# ===========================================
# Google OAuth Configuration (Optional)
# ===========================================
# Get FREE credentials at: https://console.cloud.google.com
# 1. Create project → OAuth consent screen → OAuth client ID
# 2. Add redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET_HERE
NEXT_PUBLIC_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE

# ===========================================
# Google Maps Configuration (Optional)
# ===========================================
# In same Google Cloud project:
# 1. Enable "Maps JavaScript API"
# 2. Create API key
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# ===========================================
# Google Analytics Configuration (Optional)
# ===========================================
# Get FREE account at: https://analytics.google.com
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ===========================================
# Cloudinary Configuration (Optional)
# ===========================================
# Get FREE account at: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME_HERE
CLOUDINARY_API_KEY=YOUR_API_KEY_HERE
CLOUDINARY_API_SECRET=YOUR_API_SECRET_HERE

# ===========================================
# Push Notifications Configuration (Optional)
# ===========================================
# Generate with: npm install -g web-push && web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY_HERE
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY_HERE

# ===========================================
# Socket.IO Configuration
# ===========================================
SOCKET_IO_URL=http://localhost:3000

# ===========================================
# Application Configuration
# ===========================================
NODE_ENV=development

# ===========================================
# 🔒 Security Note
# ===========================================
# This file contains secrets. Never commit to git!
# It's already in .gitignore for your safety.

