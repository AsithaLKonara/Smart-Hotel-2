generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ==========================================
// PROPERTY STRUCTURE
// ==========================================

model RoomType {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  name                  String   @unique 
  description           String
  baseRate              Float
  capacity              Int      @default(2)
  amenities             String[]
  images                String[]
  totalRooms            Int      @default(0)
  otaMappingId          String?  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  rooms                 Room[]
}

model Room {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  version         Int              @default(1) 
  number          String           @unique
  floor           Int
  capacity        Int              @default(2)
  size            Int              @default(25)
  roomTypeId      String           @db.ObjectId
  status          RoomStatus       @default(AVAILABLE)
  lastCleanedAt   DateTime?
  lastInspectedAt DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  
  roomType        RoomType         @relation(fields: [roomTypeId], references: [id])
  bookings        Booking[]
  tasks           Task[]
  statusHistory   RoomStatusHistory[]
  maintenance     MaintenanceRequest[]
  roomImages      RoomImage[]
  reviews         RoomReview[]

  @@index([status])
  @@index([roomTypeId])
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  DIRTY
  CLEANING
  INSPECTION_PENDING
  MAINTENANCE
  OUT_OF_ORDER
}

model RoomStatusHistory {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  roomId    String     @db.ObjectId
  oldStatus RoomStatus
  newStatus RoomStatus
  actorId   String     @db.ObjectId
  reason    String?
  createdAt DateTime   @default(now())
  
  room      Room       @relation(fields: [roomId], references: [id])
}

model RoomImage {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  roomId       String   @db.ObjectId
  imageUrl     String
  isMain       Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  room         Room     @relation(fields: [roomId], references: [id])
}

// ==========================================
// BOOKING & GUESTS
// ==========================================

model Booking {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
  version          Int              @default(1)
  confirmationCode String           @unique
  checkIn          DateTime         @db.Date
  checkOut         DateTime         @db.Date
  status           BookingStatus    @default(CONFIRMED)
  source           BookingSource    @default(WEBSITE)
  otaReference     String?
  
  roomId           String           @db.ObjectId
  primaryGuestId   String           @db.ObjectId
  
  guests           Int              @default(1)
  totalAmount      Float
  paymentStatus    PaymentStatus    @default(unpaid)
  paymentMethod    String?          
  paymentProvider  String?          
  
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  
  room             Room             @relation(fields: [roomId], references: [id])
  guest            User             @relation("PrimaryGuest", fields: [primaryGuestId], references: [id])
  additionalGuests BookingGuest[]
  invoices         Invoice[]
  payments         Payment[]
  tasks            Task[]
  roomReviews      RoomReview[]
  complaints       Complaint[]
  
  @@index([checkIn, checkOut])
  @@index([status])
}

model Event {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  eventDate   DateTime
  startTime   String?
  endTime     String?
  location    String?
  capacity    Int?
  category    String?
  status      EventStatus @default(upcoming)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([eventDate])
  @@index([status])
}

enum EventStatus {
  upcoming
  ongoing
  completed
  cancelled
}

model BookingGuest {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  bookingId String   @db.ObjectId
  userId    String?  @db.ObjectId 
  name      String
  email     String?
  phone     String?
  identity  String?  
  isMinor   Boolean  @default(false)
  
  booking   Booking  @relation(fields: [bookingId], references: [id])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum BookingSource {
  WALK_IN
  WEBSITE
  BOOKING_COM
  AGODA
  EXPEDIA
}

// ==========================================
// FINANCIALS
// ==========================================

model Invoice {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  invoiceNo   String   @unique
  bookingId   String   @db.ObjectId
  subtotal    Float
  taxAmount   Float
  grandTotal  Float
  status      String   
  issuedAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  booking     Booking  @relation(fields: [bookingId], references: [id])
  lineItems   InvoiceLineItem[]
}

model InvoiceLineItem {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  invoiceId   String   @db.ObjectId
  description String
  quantity    Int
  unitPrice   Float
  totalPrice  Float
  category    String   
  
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
}

model Payment {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  bookingId       String?       @db.ObjectId
  orderId         String?       @db.ObjectId
  userId          String?       @db.ObjectId
  amount          Float
  currency        String        @default("LKR")
  paymentMethod   PaymentMethod @default(card)
  paymentProvider String?       
  providerId      String?       @unique
  status          PaymentStatus @default(pending)
  capturedAt      DateTime?
  refundedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  booking         Booking?      @relation(fields: [bookingId], references: [id])
  order           FoodOrder?    @relation(fields: [orderId], references: [id])
  user            User?         @relation(fields: [userId], references: [id])
  adjustments     FinancialAdjustment[]
}

model FinancialAdjustment {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  paymentId   String   @db.ObjectId
  type        String   
  amount      Float
  reason      String
  createdAt   DateTime @default(now())
  
  payment     Payment  @relation(fields: [paymentId], references: [id])
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
  unpaid
  partial
}

enum PaymentMethod {
  cash
  card
  bank_transfer
  crypto
  other
}

// ==========================================
// OPERATIONS
// ==========================================

model Task {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  version         Int         @default(1)
  type            TaskType
  status          TaskStatus  @default(PENDING)
  priority        Priority    @default(MEDIUM)
  title           String
  description     String?
  assignedTo      String?     @db.ObjectId
  roomId          String?     @db.ObjectId
  bookingId       String?     @db.ObjectId
  createdBy       String?     @db.ObjectId
  dueDate         DateTime?
  
  assignedStaff   Staff?      @relation("StaffTasks", fields: [assignedTo], references: [id])
  creator         User?       @relation("CreatedTasks", fields: [createdBy], references: [id])
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  acceptedAt      DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  verifiedAt      DateTime?
  elapsedMinutes  Int?
  
  room            Room?       @relation(fields: [roomId], references: [id])
  booking         Booking?    @relation(fields: [bookingId], references: [id])
}

enum TaskType {
  HOUSEKEEPING
  MAINTENANCE
  ROOM_SERVICE
  GUEST_REQUEST
  ADMINISTRATIVE
}

enum TaskStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  VERIFIED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model MaintenanceRequest {
  id          String              @id @default(auto()) @map("_id") @db.ObjectId
  roomId      String?             @db.ObjectId
  userId      String              @db.ObjectId
  assignedTo  String?             @db.ObjectId
  title       String
  description String
  category    String
  priority    MaintenancePriority @default(medium)
  status      MaintenanceStatus   @default(pending)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  
  room        Room?               @relation(fields: [roomId], references: [id])
}

enum MaintenancePriority {
  low
  medium
  high
  urgent
}

enum MaintenanceStatus {
  pending
  in_progress
  completed
  cancelled
}

// ==========================================
// KITCHEN & ROOM SERVICE
// ==========================================

model FoodOrder {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  guestId         String      @db.ObjectId
  roomNumber      String
  status          String      
  totalAmount     Float
  specialRequests String?
  deliveryTime    DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  items           OrderItem[]
  payments        Payment[]
  guest           User        @relation("GuestOrders", fields: [guestId], references: [id])
}

model OrderItem {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  orderId    String    @db.ObjectId
  menuItemId String    @db.ObjectId
  quantity   Int
  price      Float
  subtotal   Float
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  
  order      FoodOrder @relation(fields: [orderId], references: [id])
  menuItem   FoodMenu  @relation(fields: [menuItemId], references: [id])
}

model FoodMenu {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  description     String
  category        String
  price           Float
  available       Boolean     @default(true)
  preparationTime Int         
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  orderItems      OrderItem[]
}

// ==========================================
// USERS & GUESTS
// ==========================================

model User {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
  email            String           @unique
  name             String
  phone            String?
  password         String
  role             UserRole         @default(GUEST)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  
  guestBookings    Booking[]        @relation("PrimaryGuest")
  loyalty          LoyaltyPoint?
  staffProfile     Staff?
  guestPreferences GuestPreference?
  reviews          RoomReview[]
  hotelReviews     HotelReview[]
  tableBookings    TableBooking[]
  complaints       Complaint[]
  foodOrders       FoodOrder[]      @relation("GuestOrders")
  payments         Payment[]
  notifications    Notification[]
  createdTasks     Task[]           @relation("CreatedTasks")
  auditLogs        AuditLog[]
}


model GuestPreference {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  userId              String   @unique @db.ObjectId
  dietaryRestrictions String[]
  allergies           String[]
  roomPreferences     String[]
  user                User     @relation(fields: [userId], references: [id])
}

model Staff {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  userId     String    @unique @db.ObjectId
  employeeId String    @unique
  name       String
  email      String?
  phone      String?
  position   String
  department String
  hireDate   DateTime  @default(now())
  salary     Float     @default(0)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  
  tasks      Task[]    @relation("StaffTasks")
  user       User      @relation(fields: [userId], references: [id])
}

enum UserRole {
  SUPER_ADMIN
  MANAGER
  RECEPTIONIST
  HOUSEKEEPING
  MAINTENANCE
  KITCHEN
  GUEST
}

// ==========================================
// FEEDBACK
// ==========================================

model RoomReview {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  roomId    String   @db.ObjectId
  userId    String   @db.ObjectId
  bookingId String?  @db.ObjectId
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  
  room      Room     @relation(fields: [roomId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  booking   Booking? @relation(fields: [bookingId], references: [id])
}

model HotelReview {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String   @db.ObjectId
  rating            Int      @default(5) // Legacy compatibility (mapped to overall)
  overallRating     Int      @default(5)
  serviceRating     Int?
  cleanlinessRating Int?
  valueRating       Int?
  title             String?
  comment           String?
  verified          Boolean  @default(false)
  createdAt         DateTime @default(now())
  
  user              User     @relation(fields: [userId], references: [id])
}

model Amenity {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String   @unique
  description  String?
  category     String?
  icon         String?
  active       Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Knowledge {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  category    String?
  content     String
  embedding   Float[]
  metadata    Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

model EmbeddingCache {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  text      String   @unique
  embedding Float[]
  model     String   @default("nomic-embed-text-v1_5")
  createdAt DateTime @default(now())
}

// ==========================================
// INFRA & OTA
// ==========================================

model Notification {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  type      String
  title     String
  message   String
  link      String?
  read      Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
}

model Outbox {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  topic       String
  payload     Json
  status      String   @default("PENDING")
  attempts    Int      @default(0)
  createdAt   DateTime @default(now())
  processedAt DateTime?
}

model SyncLog {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  direction    String   
  status       String   
  entityType   String   
  entityId     String?  
  payload      Json?
  errorMessage String?
  attempts     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?  @db.ObjectId
  actor     String
  action    String
  resource  String
  resourceId String?
  details   Json?
  createdAt DateTime @default(now())
  
  user      User?    @relation(fields: [userId], references: [id])
}

model ChannelConfig {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  provider   String   
  apiKey     String
  propertyId String
  isEnabled  Boolean  @default(true)
}

model RoomMapping {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  localRoomTypeId       String   @db.ObjectId
  otaRoomTypeId         String
  otaRatePlanId         String?  
  priceMarkupPercentage Float    @default(15.0)
  syncEnabled           Boolean  @default(true)
}

// ==========================================
// CHAT & AI
// ==========================================

model Gallery {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  imageUrl  String
  category  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

model HeroSlide {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  image       String
  title       String
  subtitle    String
  description String
  cta         String
  ctaLink     String
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, order])
}

model Inventory {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  category    String
  quantity    BigInt   @default(0)
  unit        String
  minQuantity BigInt   @default(0)
  status      String   @default("IN_STOCK")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([status])
}

model LoyaltyPoint {
  id           String               @id @default(auto()) @map("_id") @db.ObjectId
  userId       String               @unique @db.ObjectId
  points       Int                  @default(0)
  totalEarned  Int                  @default(0)
  totalSpent   Int                  @default(0)
  tier         String               @default("SILVER")
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  user         User                 @relation(fields: [userId], references: [id])
  transactions LoyaltyTransaction[]
}

model LoyaltyTransaction {
  id             String                 @id @default(auto()) @map("_id") @db.ObjectId
  loyaltyPointId String                 @db.ObjectId
  type           LoyaltyTransactionType
  points         Int
  description    String
  referenceId    String?
  createdAt      DateTime               @default(now())

  loyaltyPoint   LoyaltyPoint           @relation(fields: [loyaltyPointId], references: [id])

  @@index([loyaltyPointId])
}

enum LoyaltyTransactionType {
  earned
  spent
  expired
}

model NavigationLink {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  href      String
  icon      String?
  order     Int        @default(0)
  active    Boolean    @default(true)
  roles     UserRole[] @default([])
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([active, order])
}

model Conversation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionId String
  userId    String
  message   String
  response  String
  timestamp DateTime @default(now())

  @@index([sessionId])
  @@index([userId])
}

model ChatCustomer {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  phone       String   @unique
  name        String?
  lastOrderId String?
  preferences Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Setting {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SocialLink {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  platform  String
  url       String
  icon      String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, order])
}

model TableBooking {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String?  @db.ObjectId
  name            String
  email           String
  phone           String
  guests          Int
  bookingDate     DateTime
  bookingTime     String
  status          String   @default("PENDING") 
  specialRequests String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User?    @relation(fields: [userId], references: [id])
}

model Complaint {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  bookingId   String?  @db.ObjectId
  subject     String
  description String
  category    String   
  status      String   @default("OPEN") 
  priority    Priority @default(MEDIUM)
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id])
  booking     Booking? @relation(fields: [bookingId], references: [id])
}

model Testimonial {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  role      String?  
  content   String
  rating    Int      @default(5)
  image     String?
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}
