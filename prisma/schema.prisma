generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// PROPERTY STRUCTURE
// ==========================================

model RoomType {
  id           String   @id @default(uuid())
  name         String   @unique
  description  String
  baseRate     Float
  capacity     Int      @default(2)
  amenities    String[]
  images       String[]
  totalRooms   Int      @default(0)
  otaMappingId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rooms       Room[]
  groupBlocks GroupBlock[]
}

model Room {
  id                 String     @id @default(uuid())
  version            Int        @default(1)
  number             String     @unique
  floor              Int
  capacity           Int        @default(2)
  size               Int        @default(25)
  roomTypeId         String
  status             RoomStatus @default(AVAILABLE)
  lastStatusChangeAt DateTime?  @default(now())
  lockId             String?
  lockExpiresAt      DateTime?
  lastCleanedAt      DateTime?
  lastInspectedAt    DateTime?
  deletedAt          DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  roomType              RoomType               @relation(fields: [roomTypeId], references: [id])
  tasks                 Task[]
  statusHistory         RoomStatusHistory[]
  roomImages            RoomImage[]
  reviews               RoomReview[]
  internalOrders        InternalOrder[]
  stays                 Stay[]
  roomAssignments       RoomAssignment[]
  maintenanceWorkOrders MaintenanceWorkOrder[]
  outOfOrderRecords     OutOfOrderRecord[]

  @@index([status])
  @@index([roomTypeId])
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  DIRTY
  CLEANING
  INSPECTION_PENDING
  MAINTENANCE
  OUT_OF_ORDER
}

model RoomStatusHistory {
  id        String     @id @default(uuid())
  roomId    String
  oldStatus RoomStatus
  newStatus RoomStatus
  actorId   String
  reason    String?
  createdAt DateTime   @default(now())

  room Room @relation(fields: [roomId], references: [id])
}

model RoomImage {
  id           String   @id @default(uuid())
  roomId       String
  imageUrl     String
  isMain       Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  room Room @relation(fields: [roomId], references: [id])
}

// ==========================================
// BOOKING & GUESTS
// ==========================================

model Stay {
  id           String     @id @default(uuid())
  bookingId    String     @unique
  roomId       String
  status       StayStatus @default(EXPECTED)
  checkInTime  DateTime?
  checkOutTime DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])
  room    Room    @relation(fields: [roomId], references: [id])
}

enum StayStatus {
  EXPECTED
  CHECKED_IN
  CHECKED_OUT
  NO_SHOW
}

model Booking {
  id               String        @id @default(uuid())
  version          Int           @default(1)
  confirmationCode String        @unique
  checkIn          DateTime      @db.Date
  checkOut         DateTime      @db.Date
  status           BookingStatus @default(CONFIRMED)
  source           BookingSource @default(WEBSITE)
  otaReference     String?

  primaryGuestId String

  guests          Int           @default(1)
  totalAmount     Float
  paymentStatus   PaymentStatus @default(unpaid)
  paymentMethod   String?
  paymentProvider String?

  checkoutRequestId   String?   @unique
  checkoutFinalizedAt DateTime?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  guest            User             @relation("PrimaryGuest", fields: [primaryGuestId], references: [id])
  additionalGuests BookingGuest[]
  payments         Payment[]
  tasks            Task[]
  roomReviews      RoomReview[]
  complaints       Complaint[]
  stay             Stay?
  roomAssignments  RoomAssignment[]
  stayEvents       StayEvent[]
  folios           Folio[]

  @@index([checkIn, checkOut])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([primaryGuestId, paymentStatus])
  @@index([source, status])
  @@index([status, checkIn, checkOut])
}

model Event {
  id          String      @id @default(uuid())
  name        String
  description String?
  eventDate   DateTime
  startTime   String?
  endTime     String?
  location    String?
  capacity    Int?
  category    String?
  status      EventStatus @default(upcoming)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([eventDate])
  @@index([status])
}

enum EventStatus {
  upcoming
  ongoing
  completed
  cancelled
}

model BookingGuest {
  id        String  @id @default(uuid())
  bookingId String
  userId    String?
  name      String
  email     String?
  phone     String?
  identity  String?
  isMinor   Boolean @default(false)

  booking Booking @relation(fields: [bookingId], references: [id])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum BookingSource {
  WALK_IN
  WEBSITE
  BOOKING_COM
  AGODA
  EXPEDIA
}

model RoomAssignment {
  id        String   @id @default(uuid())
  bookingId String
  roomId    String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  status    String   @default("ACTIVE") // ACTIVE, MOVED, COMPLETED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])
  room    Room    @relation(fields: [roomId], references: [id])

  @@index([bookingId])
  @@index([roomId])
}

model StayEvent {
  id        String   @id @default(uuid())
  bookingId String
  type      String // CHECK_IN, CHECK_OUT, ROOM_MOVE, EXTENSION
  timestamp DateTime @default(now())
  notes     String?
  actorId   String?

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
}

// ==========================================
// FINANCIALS
// ==========================================

model JournalEntry {
  id            String   @id @default(uuid())
  transactionId String?
  accountId     String
  debit         Float    @default(0)
  credit        Float    @default(0)
  description   String
  postingDate   DateTime @db.Date
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model NightAuditLog {
  id             String   @id @default(uuid())
  businessDate   DateTime @db.Date
  totalRevenue   Float
  roomsProcessed Int
  status         String   @default("COMPLETED")
  runByUserId    String?
  createdAt      DateTime @default(now())

  user            User?            @relation(fields: [runByUserId], references: [id])
  revenuePostings RevenuePosting[]
}

model Payment {
  id              String        @id @default(uuid())
  version         Int           @default(1)
  bookingId       String?
  orderId         String?
  folioId         String?
  userId          String?
  amount          Float
  currency        String        @default("LKR")
  paymentMethod   PaymentMethod @default(card)
  paymentProvider String?
  providerId      String?       @unique
  status          PaymentStatus @default(pending)
  capturedAt      DateTime?
  refundedAt      DateTime?
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  booking     Booking?              @relation(fields: [bookingId], references: [id])
  internalOrder InternalOrder?      @relation(fields: [orderId], references: [id])
  folio       Folio?                @relation(fields: [folioId], references: [id])
  user        User?                 @relation(fields: [userId], references: [id])
  adjustments FinancialAdjustment[]

  @@index([createdAt])
  @@index([status])
  @@index([status, createdAt])
  @@index([paymentMethod, status])
  @@index([orderId])
  @@index([bookingId])
  @@index([folioId])
}

model FinancialAdjustment {
  id        String   @id @default(uuid())
  paymentId String
  type      String
  amount    Float
  reason    String
  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
  unpaid
  partial
}

enum PaymentMethod {
  cash
  card
  bank_transfer
  crypto
  other
}

model Folio {
  id        String    @id @default(uuid())
  bookingId String?
  type      String    @default("GUEST") // MASTER, GUEST, ROUTING
  status    String    @default("OPEN") // OPEN, CLOSED, LOCKED
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  booking            Booking?        @relation(fields: [bookingId], references: [id])
  lineItems          FolioLineItem[]
  payments           Payment[]
  internalOrders     InternalOrder[]
  routingRulesSource RoutingRule[]   @relation("SourceFolio")
  routingRulesTarget RoutingRule[]   @relation("TargetFolio")

  @@index([bookingId])
}

model FolioLineItem {
  id          String   @id @default(uuid())
  folioId     String
  description String
  amount      Float
  category    String
  isRouted    Boolean  @default(false)
  createdAt   DateTime @default(now())

  folio Folio @relation(fields: [folioId], references: [id])

  @@index([folioId])
}

model RoutingRule {
  id            String   @id @default(uuid())
  sourceFolioId String
  targetFolioId String
  criteria      Json // e.g. { category: "ROOM_CHARGE" }
  createdAt     DateTime @default(now())

  sourceFolio Folio @relation("SourceFolio", fields: [sourceFolioId], references: [id])
  targetFolio Folio @relation("TargetFolio", fields: [targetFolioId], references: [id])
}

model RevenuePosting {
  id              String   @id @default(uuid())
  nightAuditLogId String
  category        String
  amount          Float
  createdAt       DateTime @default(now())

  nightAuditLog NightAuditLog @relation(fields: [nightAuditLogId], references: [id])
}

// ==========================================
// OPERATIONS
// ==========================================

model Task {
  id          String     @id @default(uuid())
  version     Int        @default(1)
  type        TaskType
  status      TaskStatus @default(PENDING)
  priority    Priority   @default(MEDIUM)
  title       String
  description String?
  assignedTo  String?
  roomId      String?
  bookingId   String?
  createdBy   String?
  dueDate     DateTime?

  assignedEmployee Employee? @relation("EmployeeTasks", fields: [assignedTo], references: [id])
  creator          User?     @relation("CreatedTasks", fields: [createdBy], references: [id])

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  acceptedAt     DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  verifiedAt     DateTime?
  elapsedMinutes Int?
  deletedAt      DateTime?

  room    Room?    @relation(fields: [roomId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])

  @@index([assignedTo])
  @@index([roomId])
  @@index([bookingId])
}

enum TaskType {
  HOUSEKEEPING
  MAINTENANCE
  ROOM_SERVICE
  GUEST_REQUEST
  ADMINISTRATIVE
}

enum TaskStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  VERIFIED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ==========================================
// KITCHEN & ROOM SERVICE
// ==========================================





model YieldRule {
  id              String   @id @default(uuid())
  name            String
  description     String?
  startDate       DateTime @db.Date
  endDate         DateTime @db.Date
  
  // Dynamic Configuration Overrides
  minOccupancy    Float?
  maxOccupancy    Float?
  competitorPrice Float?
  
  adjustmentType  String // 'DYNAMIC_TIER', 'PERCENTAGE' or 'FIXED'
  adjustmentValue Float
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ==========================================
// ENTERPRISE POS (RESTAURANT, BAR, SPA)
// ==========================================

model POSOutlet {
  id          String   @id @default(uuid())
  name        String
  type        String // RESTAURANT, BAR, SPA, RETAIL
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products POSProduct[]
  internalOrders InternalOrder[]
}

model POSProduct {
  id        String   @id @default(uuid())
  outletId  String
  name      String
  category  String
  price     Float
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlet     POSOutlet      @relation(fields: [outletId], references: [id])
  internalOrderItems InternalOrderItem[]
}





// ==========================================
// EVENTS & BANQUETING (PHASE 6)
// ==========================================

model EventSpace {
  id         String   @id @default(uuid())
  name       String
  capacity   Int
  hourlyRate Float
  dailyRate  Float
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  bookings EventBooking[]
}

model BanquetingEvent {
  id                String   @id @default(uuid())
  name              String
  type              String // CONFERENCE, WEDDING, MEETING
  status            String // PROSPECT, TENTATIVE, DEFINITE, CANCELLED
  startDate         DateTime @db.Date
  endDate           DateTime @db.Date
  expectedAttendees Int
  organizerName     String
  organizerEmail    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  spaceBookings EventBooking[]
  groupBlocks   GroupBlock[]
}

model EventBooking {
  id        String   @id @default(uuid())
  eventId   String
  spaceId   String
  startTime DateTime
  endTime   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event BanquetingEvent @relation(fields: [eventId], references: [id])
  space EventSpace      @relation(fields: [spaceId], references: [id])
}

model GroupBlock {
  id             String   @id @default(uuid())
  eventId        String
  roomTypeId     String
  blockedCount   Int
  contractedRate Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  event    BanquetingEvent @relation(fields: [eventId], references: [id])
  roomType RoomType        @relation(fields: [roomTypeId], references: [id])
}

model FoodMenu {
  id              String      @id @default(uuid())
  name            String
  description     String
  category        String
  price           Float
  available       Boolean     @default(true)
  preparationTime Int
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  internalOrderItems InternalOrderItem[]
}

// ==========================================
// USERS & GUESTS
// ==========================================

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  name      String
  phone     String?
  password  String
  roleId    String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  vipStatus          String  @default("STANDARD")
  blacklistStatus    Boolean @default(false)
  blacklistReason    String?
  corporateAccountId String?
  travelAgentId      String?

  corporateAccount CorporateAccount? @relation(fields: [corporateAccountId], references: [id])
  travelAgent      TravelAgent?      @relation(fields: [travelAgentId], references: [id])
  guestHistory     GuestHistory?

  guestBookings      Booking[]           @relation("PrimaryGuest")
  loyalty            LoyaltyPoint?
  guestPreferences   GuestPreference?
  reviews            RoomReview[]
  hotelReviews       HotelReview[]
  tableBookings      TableBooking[]
  complaints         Complaint[]
  internalOrders     InternalOrder[]         @relation("GuestInternalOrders")
  payments           Payment[]
  notifications      Notification[]
  createdTasks       Task[]              @relation("CreatedTasks")
  auditLogs          AuditLog[]
  nightAuditsRun     NightAuditLog[]
  employee           Employee?
  role               Role?               @relation(fields: [roleId], references: [id])
  guestConversations GuestConversation[]
  resortBookings     ResortBooking[]
  guestProfile       GuestProfile?
}

model GuestPreference {
  id                  String   @id @default(uuid())
  userId              String   @unique
  dietaryRestrictions String[]
  allergies           String[]
  roomPreferences     String[]
  user                User     @relation(fields: [userId], references: [id])
}

model GuestProfile {
  id            String   @id @default(uuid())
  userAccountId String   @unique
  preferences   Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userAccountId], references: [id])
}

model CorporateAccount {
  id             String   @id @default(uuid())
  companyName    String   @unique
  contactName    String
  contactEmail   String
  contactPhone   String
  negotiatedRate Float?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users User[]
}

model TravelAgent {
  id             String   @id @default(uuid())
  agencyName     String   @unique
  iataNumber     String?
  contactName    String
  contactEmail   String
  contactPhone   String
  commissionRate Float    @default(10.0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users User[]
}

model GuestHistory {
  id             String    @id @default(uuid())
  userId         String    @unique
  totalStays     Int       @default(0)
  totalNights    Int       @default(0)
  totalSpend     Float     @default(0)
  lastStayDate   DateTime?
  lastRoomTypeId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(uuid())
  action      String           @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// ==========================================
// FEEDBACK
// ==========================================

model RoomReview {
  id        String   @id @default(uuid())
  roomId    String
  userId    String
  bookingId String?
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  room    Room     @relation(fields: [roomId], references: [id])
  user    User     @relation(fields: [userId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])
}

model HotelReview {
  id                String   @id @default(uuid())
  userId            String
  rating            Int      @default(5) // Legacy compatibility (mapped to overall)
  overallRating     Int      @default(5)
  serviceRating     Int?
  cleanlinessRating Int?
  valueRating       Int?
  title             String?
  comment           String?
  verified          Boolean  @default(false)
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Amenity {
  id           String   @id @default(uuid())
  name         String   @unique
  description  String?
  category     String?
  icon         String?
  active       Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Knowledge {
  id        String   @id @default(uuid())
  category  String?
  content   String
  embedding Float[]
  metadata  Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

model EmbeddingCache {
  id        String   @id @default(uuid())
  text      String   @unique
  embedding Float[]
  model     String   @default("nomic-embed-text-v1_5")
  createdAt DateTime @default(now())
}

// ==========================================
// INFRA & OTA
// ==========================================

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  link      String?
  read      Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
}

model Outbox {
  id          String    @id @default(uuid())
  topic       String
  payload     Json
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())
  processedAt DateTime?
}

model SyncLog {
  id           String   @id @default(uuid())
  direction    String
  status       String
  entityType   String
  entityId     String?
  payload      Json?
  errorMessage String?
  attempts     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  actor      String
  action     String
  resource   String
  resourceId String?
  details    Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model ChannelConfig {
  id         String  @id @default(uuid())
  provider   String
  apiKey     String
  propertyId String
  isEnabled  Boolean @default(true)
}

model RoomMapping {
  id                    String  @id @default(uuid())
  localRoomTypeId       String
  otaRoomTypeId         String
  otaRatePlanId         String?
  priceMarkupPercentage Float   @default(15.0)
  syncEnabled           Boolean @default(true)
}

// ==========================================
// CHAT & AI
// ==========================================

model Gallery {
  id        String   @id @default(uuid())
  title     String
  imageUrl  String
  category  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

model HeroSlide {
  id          String   @id @default(uuid())
  image       String
  title       String
  subtitle    String
  description String
  cta         String
  ctaLink     String
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, order])
}

model Inventory {
  id          String   @id @default(uuid())
  name        String
  description String?
  category    String
  unit        String
  minQuantity BigInt   @default(0)
  status      String   @default("IN_STOCK")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([status])
}

model LoyaltyPoint {
  id          String   @id @default(uuid())
  userId      String   @unique
  points      Int      @default(0)
  totalEarned Int      @default(0)
  totalSpent  Int      @default(0)
  tier        String   @default("SILVER")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User                 @relation(fields: [userId], references: [id])
  transactions LoyaltyTransaction[]
}

model LoyaltyTransaction {
  id             String                 @id @default(uuid())
  loyaltyPointId String
  type           LoyaltyTransactionType
  points         Int
  description    String
  referenceId    String?
  createdAt      DateTime               @default(now())

  loyaltyPoint LoyaltyPoint @relation(fields: [loyaltyPointId], references: [id])

  @@index([loyaltyPointId])
}

enum LoyaltyTransactionType {
  earned
  spent
  expired
}

model NavigationLink {
  id        String   @id @default(uuid())
  name      String
  href      String
  icon      String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  roles     String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, order])
}

model Conversation {
  id        String   @id @default(uuid())
  sessionId String
  userId    String
  message   String
  response  String
  timestamp DateTime @default(now())

  @@index([sessionId])
  @@index([userId])
}

model ChatCustomer {
  id          String   @id @default(uuid())
  phone       String   @unique
  name        String?
  lastOrderId String?
  preferences Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SocialLink {
  id        String   @id @default(uuid())
  platform  String
  url       String
  icon      String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, order])
}

model TableBooking {
  id              String   @id @default(uuid())
  userId          String?
  name            String
  email           String
  phone           String
  guests          Int
  bookingDate     DateTime
  bookingTime     String
  status          String   @default("PENDING")
  specialRequests String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id])
}

model Complaint {
  id          String    @id @default(uuid())
  userId      String
  bookingId   String?
  subject     String
  description String
  category    String
  status      String    @default("OPEN")
  priority    Priority  @default(MEDIUM)
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user    User     @relation(fields: [userId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])
}

model Testimonial {
  id        String   @id @default(uuid())
  name      String
  role      String?
  content   String
  rating    Int      @default(5)
  image     String?
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model FooterLink {
  id        String   @id @default(uuid())
  label     String
  url       String
  category  String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([active, order])
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("UNREAD") // UNREAD, READ, REPLIED, ARCHIVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([status])
}

model FAQ {
  id        String   @id @default(uuid())
  question  String
  answer    String
  category  String   @default("General")
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([active, order])
}

// ==========================================
// PROCUREMENT & INVENTORY (PHASE 9)
// ==========================================

model Vendor {
  id            String   @id @default(uuid())
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items          InventoryItem[]
  purchaseOrders PurchaseOrder[]
}

model InventoryItem {
  id        String   @id @default(uuid())
  name      String
  sku       String?  @unique
  category  String // FOOD, BEVERAGE, LINEN, MAINTENANCE
  unit      String // KG, LITER, PIECE, BOX
  unitPrice Float
  parLevel  Int      @default(10) // Reorder threshold
  vendorId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor        Vendor?             @relation(fields: [vendorId], references: [id])
  stocks        InventoryStock[]
  purchaseItems PurchaseOrderItem[]
  movements     InventoryMovement[]
}

model InventoryStock {
  id            String   @id @default(uuid())
  itemId        String
  location      String // MAIN_STORE, KITCHEN, BAR, HOUSEKEEPING
  quantity      Int      @default(0)
  lastCountedAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  item InventoryItem @relation(fields: [itemId], references: [id])

  @@unique([itemId, location])
}

model PurchaseOrder {
  id           String    @id @default(uuid())
  orderNumber  String    @unique
  vendorId     String
  status       String // DRAFT, PENDING_APPROVAL, APPROVED, DELIVERED, CANCELLED
  totalAmount  Float     @default(0)
  expectedDate DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  vendor         Vendor              @relation(fields: [vendorId], references: [id])
  items          PurchaseOrderItem[]
  goodsReceipts  GoodsReceipt[]
  vendorInvoices VendorInvoice[]
}

model PurchaseOrderItem {
  id              String   @id @default(uuid())
  purchaseOrderId String
  itemId          String
  quantity        Int
  unitPrice       Float
  totalPrice      Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  item          InventoryItem @relation(fields: [itemId], references: [id])
}

model InventoryMovement {
  id        String   @id @default(uuid())
  itemId    String
  type      String // RECEIPT, CONSUMPTION, TRANSFER, ADJUSTMENT
  quantity  Int
  notes     String?
  createdAt DateTime @default(now())

  item InventoryItem @relation(fields: [itemId], references: [id])
}

model GoodsReceipt {
  id              String   @id @default(uuid())
  purchaseOrderId String
  receivedDate    DateTime @default(now())
  notes           String?

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
}

model VendorInvoice {
  id              String   @id @default(uuid())
  purchaseOrderId String
  invoiceNumber   String
  amount          Float
  receivedDate    DateTime @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
}

// ==========================================
// HR & WORKFORCE (PHASE 10)
// ==========================================

model Employee {
  id         String   @id @default(uuid())
  userId     String?  @unique
  firstName  String
  lastName   String
  email      String   @unique
  phone      String?
  department String // FRONT_DESK, KITCHEN, HOUSEKEEPING, MANAGEMENT, MAINTENANCE
  position   String
  baseSalary Float
  hireDate   DateTime @db.Date
  status     String   @default("ACTIVE") // ACTIVE, ON_LEAVE, TERMINATED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user             User?             @relation(fields: [userId], references: [id])
  shifts           Shift[]
  leaves           LeaveRequest[]
  payrolls         PayrollRecord[]
  attendance       Attendance[]
  payrollLineItems PayrollLineItem[]
  tasks            Task[]            @relation("EmployeeTasks")
}

model Shift {
  id         String   @id @default(uuid())
  employeeId String
  startTime  DateTime
  endTime    DateTime
  role       String? // Optional override for specific shift role
  status     String   @default("SCHEDULED") // SCHEDULED, COMPLETED, NO_SHOW
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
}

model LeaveRequest {
  id         String   @id @default(uuid())
  employeeId String
  type       String // ANNUAL, SICK, UNPAID, MATERNITY
  startDate  DateTime @db.Date
  endDate    DateTime @db.Date
  reason     String?
  status     String   @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
}

model PayrollRecord {
  id             String    @id @default(uuid())
  employeeId     String
  periodStart    DateTime  @db.Date
  periodEnd      DateTime  @db.Date
  baseAmount     Float
  overtimeAmount Float     @default(0)
  deductions     Float     @default(0)
  bonuses        Float     @default(0)
  netPay         Float
  status         String    @default("DRAFT") // DRAFT, PAID
  paidAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
}

model Attendance {
  id         String    @id @default(uuid())
  employeeId String
  date       DateTime  @db.Date
  clockIn    DateTime
  clockOut   DateTime?
  status     String    @default("PRESENT") // PRESENT, LATE, HALF_DAY
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
}

model PayrollRun {
  id          String   @id @default(uuid())
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  status      String   @default("DRAFT") // DRAFT, FINALIZED, PAID
  totalAmount Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lineItems PayrollLineItem[]
}

model PayrollLineItem {
  id           String   @id @default(uuid())
  payrollRunId String
  employeeId   String
  basePay      Float
  overtimePay  Float    @default(0)
  deductions   Float    @default(0)
  netPay       Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id])
  employee   Employee   @relation(fields: [employeeId], references: [id])
}

// ==========================================
// CMMS & PREVENTIVE MAINTENANCE (PHASE 11)
// ==========================================

model Asset {
  id               String    @id @default(uuid())
  name             String
  category         String // HVAC, PLUMBING, ELECTRICAL, KITCHEN_EQUIPMENT
  location         String
  serialNumber     String?
  installationDate DateTime? @db.Date
  warrantyExpiry   DateTime? @db.Date
  status           String    @default("OPERATIONAL") // OPERATIONAL, MAINTENANCE, OUT_OF_ORDER
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  schedules             MaintenanceSchedule[]
  inspections           InspectionLog[]
  maintenanceWorkOrders MaintenanceWorkOrder[]
}

model MaintenanceSchedule {
  id             String    @id @default(uuid())
  assetId        String
  taskName       String
  frequencyDays  Int // e.g., 30 for monthly, 90 for quarterly
  lastRun        DateTime? @db.Date
  nextRun        DateTime  @db.Date
  assignedToRole String? // e.g. "MAINTENANCE"
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  asset Asset @relation(fields: [assetId], references: [id])
}

model InspectionLog {
  id             String   @id @default(uuid())
  assetId        String
  technicianName String
  inspectionDate DateTime @default(now())
  status         String // PASS, FAIL, REPAIR_NEEDED
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  asset Asset @relation(fields: [assetId], references: [id])
}

model MaintenanceWorkOrder {
  id        String   @id @default(uuid())
  roomId    String?
  assetId   String?
  issue     String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room  Room?  @relation(fields: [roomId], references: [id])
  asset Asset? @relation(fields: [assetId], references: [id])
}

model OutOfOrderRecord {
  id        String   @id @default(uuid())
  roomId    String
  reason    String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  createdAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id])
}

// ==========================================
// MULTI-PROPERTY & LOYALTY (PHASE 12)
// ==========================================

model Property {
  id         String   @id @default(uuid())
  name       String
  code       String   @unique // e.g. SH-NYC
  address    String
  city       String
  country    String
  timezone   String   @default("UTC")
  totalRooms Int      @default(0)
  status     String   @default("ACTIVE") // ACTIVE, PRE_OPENING, INACTIVE
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ==========================================
// GUEST MESSAGING & AI CONCIERGE (PHASE 13)
// ==========================================

model GuestConversation {
  id            String   @id @default(uuid())
  guestId       String
  status        String   @default("OPEN") // OPEN, CLOSED
  aiEnabled     Boolean  @default(true)
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  guest    User           @relation(fields: [guestId], references: [id])
  messages GuestMessage[]
}

model GuestMessage {
  id             String   @id @default(uuid())
  conversationId String
  senderType     String // GUEST, STAFF, AI
  content        String
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation GuestConversation @relation(fields: [conversationId], references: [id])
}

// ==========================================
// INTEGRATIONS & WEBHOOKS (PHASE 15)
// ==========================================

model Integration {
  id        String   @id @default(uuid())
  appName   String   @unique
  provider  String // e.g., STRIPE, QUICKBOOKS, ASSA_ABLOY
  status    String   @default("INACTIVE") // ACTIVE, INACTIVE
  apiKey    String?
  config    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WebhookEndpoint {
  id        String   @id @default(uuid())
  url       String
  event     String // e.g., GUEST_CHECKIN, PAYMENT_SUCCESS
  isActive  Boolean  @default(true)
  secret    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries    WebhookDelivery[]
  subscriptions WebhookSubscription[]
}

model WebhookDelivery {
  id                String   @id @default(uuid())
  webhookEndpointId String
  payload           Json
  status            String   @default("PENDING")
  statusCode        Int?
  attempts          Int      @default(0)
  createdAt         DateTime @default(now())

  webhookEndpoint WebhookEndpoint @relation(fields: [webhookEndpointId], references: [id])
}

model WebhookSubscription {
  id                String   @id @default(uuid())
  webhookEndpointId String
  eventTypes        String[] // Array of strings like "GUEST_CHECKIN"
  createdAt         DateTime @default(now())

  webhookEndpoint WebhookEndpoint @relation(fields: [webhookEndpointId], references: [id])
}

// ==========================================
// RESORT MODULES (PHASE 16)
// ==========================================

model ResortFacility {
  id             String   @id @default(uuid())
  name           String
  type           String // SPA, GOLF, TENNIS, CABANA
  operatingHours String   @default("09:00-18:00")
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  services ResortService[]
  bookings ResortBooking[]
}

model ResortService {
  id           String   @id @default(uuid())
  facilityId   String
  name         String
  durationMins Int
  price        Float
  createdAt    DateTime @default(now())

  facility ResortFacility @relation(fields: [facilityId], references: [id])
}

model ResortBooking {
  id         String   @id @default(uuid())
  facilityId String
  guestId    String
  startTime  DateTime
  endTime    DateTime
  status     String   @default("CONFIRMED") // CONFIRMED, COMPLETED, CANCELLED
  notes      String?
  createdAt  DateTime @default(now())

  facility ResortFacility @relation(fields: [facilityId], references: [id])
  guest    User           @relation(fields: [guestId], references: [id])
}

// SRE / INCIDENT MODULE
// ==========================================

model Incident {
  id                  String   @id @default(uuid())
  title               String
  category            String
  severity            String
  status              String   @default("OPEN")
  owner               String
  slaMinutesRemaining Int
  message             String
  notes               String   @default("")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model InternalOrder {
  id              String    @id @default(uuid())
  orderType       String    @default("IN_ROOM_DINING") // "POS_OUTLET", "IN_ROOM_DINING", "SPA"
  status          String    // PENDING, PREPARING, DELIVERED, COMPLETED, CANCELLED
  totalAmount     Float
  
  // Relations
  guestId         String?
  roomId          String?
  outletId        String?
  folioId         String?
  
  // Specific to order types
  paymentType     String?   // CASH, CARD, ROOM_CHARGE
  specialRequests String?
  deliveryTime    DateTime?
  idempotencyKey  String?   @unique
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  items    InternalOrderItem[]
  payments Payment[]
  
  guest    User?       @relation("GuestInternalOrders", fields: [guestId], references: [id])
  room     Room?       @relation(fields: [roomId], references: [id])
  outlet   POSOutlet?  @relation(fields: [outletId], references: [id])
  folio    Folio?      @relation(fields: [folioId], references: [id])

  @@index([guestId])
}

model InternalOrderItem {
  id         String   @id @default(uuid())
  orderId    String
  productId  String?  // References POSProduct
  menuItemId String?  // String reference for legacy/food orders
  quantity   Int
  price      Float
  subtotal   Float
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  order      InternalOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    POSProduct?   @relation(fields: [productId], references: [id])
  menuItem   FoodMenu?     @relation(fields: [menuItemId], references: [id])
}
