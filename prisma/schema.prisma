generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Booking {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  checkIn         DateTime @db.Date
  checkOut        DateTime @db.Date
  createdAt       DateTime @db.Date
  guests          BigInt
  paymentMethod   String
  paymentStatus   String
  roomId          String   @db.ObjectId
  specialRequests String?
  status          String
  totalAmount     Float
  updatedAt       DateTime @db.Date
  userId          String   @db.ObjectId
}

model FoodMenu {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  available       Boolean
  category        String
  createdAt       DateTime @db.Date
  description     String
  name            String
  preparationTime BigInt
  price           Float
  updatedAt       DateTime @db.Date
}

model FoodOrder {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt       DateTime @db.Date
  deliveryTime    DateTime @db.Date
  guestId         String   @db.ObjectId
  roomNumber      String
  specialRequests String
  status          String
  totalAmount     Float
  updatedAt       DateTime @db.Date
}

model Gallery {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  category  String
  createdAt DateTime @db.Date
  imageUrl  String
  title     String
  updatedAt DateTime @db.Date
}

model Inventory {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  category    String
  createdAt   DateTime @db.Date
  description String
  minQuantity BigInt
  name        String
  quantity    BigInt
  status      String
  unit        String
  updatedAt   DateTime @db.Date
}

model Room {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  amenities   String[]
  capacity    BigInt
  createdAt   DateTime @db.Date
  description String
  floor       BigInt
  images      String[]
  number      String
  price       Float
  size        BigInt
  status      String
  type        String
  updatedAt   DateTime @db.Date
}

model Setting {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  key   String
  value String
}

model Staff {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt  DateTime @db.Date
  department String
  email      String
  employeeId String
  hireDate   DateTime @db.Date
  isActive   Boolean
  name       String
  phone      String
  position   String
  salary     Float
  updatedAt  DateTime @db.Date
}

model Task {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  assignedTo  String    @db.ObjectId
  completedAt DateTime? @db.Date
  createdAt   DateTime  @db.Date
  createdBy   String    @db.ObjectId
  description String
  dueDate     DateTime  @db.Date
  priority    String
  status      String
  title       String
  type        String
  updatedAt   DateTime  @db.Date
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @db.Date
  email     String
  name      String
  password  String
  phone     String
  role      String
  updatedAt DateTime @db.Date
}
