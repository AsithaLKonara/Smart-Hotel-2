generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model RoomType {
  id               String       @id @default(uuid())
  name             String       @unique
  description      String
  baseRate         Float
  capacity         Int          @default(2)
  amenities        String[]
  images           String[]
  totalRooms       Int          @default(0)
  otaMappingId     String?
  minLengthOfStay  Int          @default(1)
  maxLengthOfStay  Int          @default(30)
  closeToArrival   Boolean      @default(false)
  closeToDeparture Boolean      @default(false)
  nonRefundable    Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  groupBlocks      GroupBlock[]
  ratePlans        RatePlan[]
  rooms            Room[]
}

model Room {
  id                    String                 @id @default(uuid())
  version               Int                    @default(1)
  number                String
  floor                 Int
  capacity              Int                    @default(2)
  size                  Int                    @default(25)
  roomTypeId            String
  status                RoomStatus             @default(AVAILABLE)
  lastStatusChangeAt    DateTime?              @default(now())
  lockId                String?
  lockExpiresAt         DateTime?
  lastCleanedAt         DateTime?
  lastInspectedAt       DateTime?
  deletedAt             DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  propertyId            String
  ownerId               String?
  feedback              Feedback[]
  internalOrders        InternalOrder[]
  maintenanceWorkOrders MaintenanceWorkOrder[]
  outOfOrderRecords     OutOfOrderRecord[]
  property              Property               @relation(fields: [propertyId], references: [id])
  roomType              RoomType               @relation(fields: [roomTypeId], references: [id])
  roomAssignments       RoomAssignment[]
  roomImages            RoomImage[]
  statusHistory         RoomStatusHistory[]
  stays                 Stay[]
  tasks                 Task[]

  @@index([status])
  @@index([roomTypeId])
  @@index([propertyId])
  @@index([number])
}

model RoomStatusHistory {
  id        String     @id @default(uuid())
  roomId    String
  oldStatus RoomStatus
  newStatus RoomStatus
  actorId   String
  reason    String?
  createdAt DateTime   @default(now())
  room      Room       @relation(fields: [roomId], references: [id])
}

model RoomImage {
  id           String   @id @default(uuid())
  roomId       String
  imageUrl     String
  isMain       Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  room         Room     @relation(fields: [roomId], references: [id])
}

model RatePlan {
  id             String         @id @default(uuid())
  name           String
  description    String?
  roomTypeId     String
  baseMultiplier Float          @default(1.0)
  isDefault      Boolean        @default(false)
  active         Boolean        @default(true)
  cancelPolicy   String         @default("FLEXIBLE")
  nonRefundable  Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  roomType       RoomType       @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  seasonalRates  SeasonalRate[]

  @@unique([name, roomTypeId])
}

model SeasonalRate {
  id               String   @id @default(uuid())
  ratePlanId       String
  name             String
  startDate        DateTime @db.Date
  endDate          DateTime @db.Date
  multiplier       Float    @default(1.0)
  baseRateOverride Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  ratePlan         RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)

  @@index([startDate, endDate])
}

model Stay {
  id           String     @id @default(uuid())
  bookingId    String     @unique
  roomId       String
  status       StayStatus @default(EXPECTED)
  checkInTime  DateTime?
  checkOutTime DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  booking      Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  room         Room       @relation(fields: [roomId], references: [id])
}

model Booking {
  id                  String           @id @default(uuid())
  version             Int              @default(1)
  confirmationCode    String
  checkIn             DateTime         @db.Date
  checkOut            DateTime         @db.Date
  status              BookingStatus    @default(CONFIRMED)
  source              BookingSource    @default(WEBSITE)
  otaReference        String?
  primaryGuestId      String
  guests              Int              @default(1)
  totalAmount         Decimal
  paymentStatus       PaymentStatus    @default(unpaid)
  paymentMethod       String?
  paymentProvider     String?
  checkoutRequestId   String?
  checkoutFinalizedAt DateTime?
  deletedAt           DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  propertyId          String
  groupBlockId        String?
  groupBlock          GroupBlock?      @relation(fields: [groupBlockId], references: [id])
  guest               User             @relation("PrimaryGuest", fields: [primaryGuestId], references: [id])
  property            Property         @relation(fields: [propertyId], references: [id])
  additionalGuests    BookingGuest[]
  complaints          Complaint[]
  feedback            Feedback[]
  folios              Folio[]
  payments            Payment[]
  roomAssignments     RoomAssignment[]
  stay                Stay?
  stayEvents          StayEvent[]
  tasks               Task[]

  @@index([checkIn, checkOut])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([primaryGuestId, paymentStatus])
  @@index([source, status])
  @@index([status, checkIn, checkOut])
  @@index([source, otaReference])
  @@index([confirmationCode])
  @@index([checkoutRequestId])
}

model Event {
  id          String      @id @default(uuid())
  name        String
  description String?
  eventDate   DateTime
  startTime   String?
  endTime     String?
  location    String?
  capacity    Int?
  category    String?
  status      EventStatus @default(upcoming)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([eventDate])
  @@index([status])
}

model BookingGuest {
  id        String  @id @default(uuid())
  bookingId String
  userId    String?
  name      String
  email     String?
  phone     String?
  identity  String?
  isMinor   Boolean @default(false)
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model RoomAssignment {
  id        String   @id @default(uuid())
  bookingId String
  roomId    String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  room      Room     @relation(fields: [roomId], references: [id])

  @@index([bookingId])
  @@index([roomId])
}

model StayEvent {
  id        String   @id @default(uuid())
  bookingId String
  type      String
  timestamp DateTime @default(now())
  notes     String?
  actorId   String?
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model JournalEntry {
  id            String   @id @default(uuid())
  transactionId String?
  accountId     String
  debit         Float    @default(0)
  credit        Float    @default(0)
  description   String
  postingDate   DateTime @db.Date
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model NightAuditLog {
  id              String           @id @default(uuid())
  businessDate    DateTime         @db.Date
  totalRevenue    Float
  roomsProcessed  Int
  status          String           @default("COMPLETED")
  runByUserId     String?
  createdAt       DateTime         @default(now())
  user            User?            @relation(fields: [runByUserId], references: [id])
  revenuePostings RevenuePosting[]
}

model Payment {
  id              String                @id @default(uuid())
  version         Int                   @default(1)
  bookingId       String?
  orderId         String?
  folioId         String?
  userId          String?
  amount          Decimal
  currency        String                @default("LKR")
  paymentMethod   PaymentMethod         @default(card)
  paymentProvider String?
  providerId      String?
  status          PaymentStatus         @default(pending)
  capturedAt      DateTime?
  refundedAt      DateTime?
  deletedAt       DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  adjustments     FinancialAdjustment[]
  booking         Booking?              @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  folio           Folio?                @relation(fields: [folioId], references: [id])
  internalOrder   InternalOrder?        @relation(fields: [orderId], references: [id])
  user            User?                 @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([status])
  @@index([status, createdAt])
  @@index([paymentMethod, status])
  @@index([orderId])
  @@index([bookingId])
  @@index([folioId])
  @@index([providerId])
}

model FinancialAdjustment {
  id        String   @id @default(uuid())
  paymentId String
  type      String
  amount    Float
  reason    String
  createdAt DateTime @default(now())
  payment   Payment  @relation(fields: [paymentId], references: [id])
}

model Folio {
  id                 String          @id @default(uuid())
  bookingId          String?
  companyId          String?
  windowNumber       Int             @default(1)
  type               String          @default("GUEST")
  status             String          @default("OPEN")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?
  propertyId         String
  booking            Booking?        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  company            CompanyProfile? @relation(fields: [companyId], references: [id])
  property           Property        @relation(fields: [propertyId], references: [id])
  lineItems          FolioLineItem[]
  internalOrders     InternalOrder[]
  payments           Payment[]
  routingRulesSource RoutingRule[]   @relation("SourceFolio")
  routingRulesTarget RoutingRule[]   @relation("TargetFolio")

  @@index([bookingId])
}

model FolioLineItem {
  id                String   @id @default(uuid())
  folioId           String
  transactionCodeId String?
  description       String
  amount            Decimal
  category          String
  isRouted          Boolean  @default(false)
  createdAt         DateTime @default(now())
  folio             Folio    @relation(fields: [folioId], references: [id])

  @@index([folioId])
  @@index([category, createdAt])
}

model RoutingRule {
  id            String   @id @default(uuid())
  sourceFolioId String
  targetFolioId String
  criteria      Json
  createdAt     DateTime @default(now())
  sourceFolio   Folio    @relation("SourceFolio", fields: [sourceFolioId], references: [id])
  targetFolio   Folio    @relation("TargetFolio", fields: [targetFolioId], references: [id])
}

model RevenuePosting {
  id              String        @id @default(uuid())
  nightAuditLogId String
  category        String
  amount          Float
  createdAt       DateTime      @default(now())
  nightAuditLog   NightAuditLog @relation(fields: [nightAuditLogId], references: [id])
}

model CompanyProfile {
  id           String   @id @default(uuid())
  name         String
  taxId        String?
  address      String?
  billingEmail String?
  creditLimit  Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  folios       Folio[]
}

model TransactionCode {
  id          String   @id
  description String
  type        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Task {
  id               String     @id @default(uuid())
  version          Int        @default(1)
  type             TaskType
  status           TaskStatus @default(PENDING)
  priority         Priority   @default(MEDIUM)
  title            String
  description      String?
  assignedTo       String?
  roomId           String?
  bookingId        String?
  createdBy        String?
  dueDate          DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  acceptedAt       DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  verifiedAt       DateTime?
  elapsedMinutes   Int?
  deletedAt        DateTime?
  propertyId       String
  assignedEmployee Employee?  @relation("EmployeeTasks", fields: [assignedTo], references: [id])
  booking          Booking?   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  creator          User?      @relation("CreatedTasks", fields: [createdBy], references: [id])
  property         Property   @relation(fields: [propertyId], references: [id])
  room             Room?      @relation(fields: [roomId], references: [id])

  @@index([assignedTo])
  @@index([roomId])
  @@index([bookingId])
}

model YieldRule {
  id              String   @id @default(uuid())
  name            String
  description     String?
  startDate       DateTime @db.Date
  endDate         DateTime @db.Date
  minOccupancy    Float?
  maxOccupancy    Float?
  competitorPrice Float?
  adjustmentType  String
  adjustmentValue Float
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model POSOutlet {
  id             String          @id @default(uuid())
  name           String
  type           String
  description    String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  internalOrders InternalOrder[]
  products       POSProduct[]
}

model POSProduct {
  id                 String              @id @default(uuid())
  outletId           String
  name               String
  category           String
  price              Float
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  internalOrderItems InternalOrderItem[]
  outlet             POSOutlet           @relation(fields: [outletId], references: [id])
}

model EventSpace {
  id         String         @id @default(uuid())
  name       String
  capacity   Int
  hourlyRate Float
  dailyRate  Float
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  bookings   EventBooking[]
}

model BanquetingEvent {
  id                String         @id @default(uuid())
  name              String
  type              String
  status            String
  startDate         DateTime       @db.Date
  endDate           DateTime       @db.Date
  expectedAttendees Int
  organizerName     String
  organizerEmail    String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  spaceBookings     EventBooking[]
  groupBlocks       GroupBlock[]
}

model EventBooking {
  id        String          @id @default(uuid())
  eventId   String
  spaceId   String
  startTime DateTime
  endTime   DateTime
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  event     BanquetingEvent @relation(fields: [eventId], references: [id])
  space     EventSpace      @relation(fields: [spaceId], references: [id])
}

model GroupBlock {
  id             String          @id @default(uuid())
  eventId        String
  roomTypeId     String
  blockedCount   Int
  contractedRate Float
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  bookings       Booking[]
  event          BanquetingEvent @relation(fields: [eventId], references: [id])
  roomType       RoomType        @relation(fields: [roomTypeId], references: [id])
}

model FoodMenu {
  id                 String              @id @default(uuid())
  name               String
  description        String
  category           String
  price              Float
  available          Boolean             @default(true)
  preparationTime    Int
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  internalOrderItems InternalOrderItem[]
}

model User {
  id                 String              @id @default(uuid())
  email              String
  name               String
  phone              String?
  password           String
  roleId             String?
  deletedAt          DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  vipStatus          String              @default("STANDARD")
  blacklistStatus    Boolean             @default(false)
  blacklistReason    String?
  corporateAccountId String?
  travelAgentId      String?
  propertyId         String
  auditLogs          AuditLog[]
  guestBookings      Booking[]           @relation("PrimaryGuest")
  complaints         Complaint[]
  employee           Employee?
  feedback           Feedback[]
  guestConversations GuestConversation[]
  guestHistory       GuestHistory?
  guestPreferences   GuestPreference?
  guestProfile       GuestProfile?
  internalOrders     InternalOrder[]     @relation("GuestInternalOrders")
  loyalty            LoyaltyPoint?
  nightAuditsRun     NightAuditLog[]
  notifications      Notification[]
  payments           Payment[]
  resortBookings     ResortBooking[]
  tableBookings      TableBooking[]
  createdTasks       Task[]              @relation("CreatedTasks")
  corporateAccount   CorporateAccount?   @relation(fields: [corporateAccountId], references: [id])
  property           Property            @relation(fields: [propertyId], references: [id])
  role               Role?               @relation(fields: [roleId], references: [id])
  travelAgent        TravelAgent?        @relation(fields: [travelAgentId], references: [id])

  @@index([email])
}

model GuestPreference {
  id                  String   @id @default(uuid())
  userId              String   @unique
  dietaryRestrictions String[]
  allergies           String[]
  roomPreferences     String[]
  user                User     @relation(fields: [userId], references: [id])
}

model GuestProfile {
  id            String   @id @default(uuid())
  userAccountId String   @unique
  preferences   Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userAccountId], references: [id])
}

model CorporateAccount {
  id             String   @id @default(uuid())
  companyName    String   @unique
  contactName    String
  contactEmail   String
  contactPhone   String
  negotiatedRate Float?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  users          User[]
}

model TravelAgent {
  id             String   @id @default(uuid())
  agencyName     String   @unique
  iataNumber     String?
  contactName    String
  contactEmail   String
  contactPhone   String
  commissionRate Float    @default(10.0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  users          User[]
}

model GuestHistory {
  id             String    @id @default(uuid())
  userId         String    @unique
  totalStays     Int       @default(0)
  totalNights    Int       @default(0)
  totalSpend     Float     @default(0)
  lastStayDate   DateTime?
  lastRoomTypeId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id])
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       User[]
}

model Permission {
  id          String           @id @default(uuid())
  action      String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Amenity {
  id           String   @id @default(uuid())
  name         String   @unique
  description  String?
  category     String?
  icon         String?
  active       Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Knowledge {
  id        String   @id @default(uuid())
  category  String?
  content   String
  embedding Float[]
  metadata  Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

model EmbeddingCache {
  id        String   @id @default(uuid())
  text      String   @unique
  embedding Float[]
  model     String   @default("nomic-embed-text-v1_5")
  createdAt DateTime @default(now())
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  link      String?
  read      Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
}

model Outbox {
  id          String    @id @default(uuid())
  topic       String
  payload     Json
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())
  processedAt DateTime?
}

model SyncLog {
  id           String   @id @default(uuid())
  direction    String
  status       String
  entityType   String
  entityId     String?
  payload      Json?
  errorMessage String?
  attempts     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  actor      String
  action     String
  resource   String
  resourceId String?
  details    Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])
}

model ChannelConfig {
  id         String  @id @default(uuid())
  provider   String
  apiKey     String
  propertyId String
  isEnabled  Boolean @default(true)
}

model RoomMapping {
  id                    String  @id @default(uuid())
  localRoomTypeId       String
  otaRoomTypeId         String
  otaRatePlanId         String?
  priceMarkupPercentage Float   @default(15.0)
  syncEnabled           Boolean @default(true)
}

model Gallery {
  id        String   @id @default(uuid())
  title     String
  imageUrl  String
  category  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

model HeroSlide {
  id          String   @id @default(uuid())
  image       String
  title       String
  subtitle    String
  description String
  cta         String
  ctaLink     String
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, order])
}

model Inventory {
  id          String   @id @default(uuid())
  name        String
  description String?
  category    String
  unit        String
  minQuantity BigInt   @default(0)
  status      String   @default("IN_STOCK")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([status])
}

model LoyaltyPoint {
  id           String               @id @default(uuid())
  userId       String               @unique
  points       Int                  @default(0)
  totalEarned  Int                  @default(0)
  totalSpent   Int                  @default(0)
  tier         String               @default("SILVER")
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  user         User                 @relation(fields: [userId], references: [id])
  transactions LoyaltyTransaction[]
}

model LoyaltyTransaction {
  id             String                 @id @default(uuid())
  loyaltyPointId String
  type           LoyaltyTransactionType
  points         Int
  description    String
  referenceId    String?
  createdAt      DateTime               @default(now())
  loyaltyPoint   LoyaltyPoint           @relation(fields: [loyaltyPointId], references: [id])

  @@index([loyaltyPointId])
}

model NavigationLink {
  id        String   @id @default(uuid())
  name      String
  href      String
  icon      String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  roles     String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, order])
}

model Conversation {
  id        String   @id @default(uuid())
  sessionId String
  userId    String
  message   String
  response  String
  timestamp DateTime @default(now())

  @@index([sessionId])
  @@index([userId])
}

model ChatCustomer {
  id          String   @id @default(uuid())
  phone       String   @unique
  name        String?
  lastOrderId String?
  preferences Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SocialLink {
  id        String   @id @default(uuid())
  platform  String
  url       String
  icon      String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, order])
}

model TableBooking {
  id              String   @id @default(uuid())
  userId          String?
  name            String
  email           String
  phone           String
  guests          Int
  bookingDate     DateTime
  bookingTime     String
  status          String   @default("PENDING")
  specialRequests String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User?    @relation(fields: [userId], references: [id])
}

model Complaint {
  id          String    @id @default(uuid())
  userId      String
  bookingId   String?
  subject     String
  description String
  category    String
  status      String    @default("OPEN")
  priority    Priority  @default(MEDIUM)
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  booking     Booking?  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id])
}

model Testimonial {
  id        String   @id @default(uuid())
  name      String
  role      String?
  content   String
  rating    Int      @default(5)
  image     String?
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model FooterLink {
  id        String   @id @default(uuid())
  label     String
  url       String
  category  String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([active, order])
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("UNREAD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([status])
}

model FAQ {
  id        String   @id @default(uuid())
  question  String
  answer    String
  category  String   @default("General")
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([active, order])
}

model Vendor {
  id             String          @id @default(uuid())
  name           String
  contactPerson  String?
  email          String?
  phone          String?
  address        String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  items          InventoryItem[]
  purchaseOrders PurchaseOrder[]
}

model InventoryItem {
  id            String              @id @default(uuid())
  name          String
  sku           String?             @unique
  category      String
  unit          String
  unitPrice     Float
  parLevel      Int                 @default(10)
  vendorId      String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  vendor        Vendor?             @relation(fields: [vendorId], references: [id])
  movements     InventoryMovement[]
  stocks        InventoryStock[]
  purchaseItems PurchaseOrderItem[]
}

model InventoryStock {
  id            String        @id @default(uuid())
  itemId        String
  location      String
  quantity      Int           @default(0)
  lastCountedAt DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  item          InventoryItem @relation(fields: [itemId], references: [id])

  @@unique([itemId, location])
}

model PurchaseOrder {
  id             String              @id @default(uuid())
  orderNumber    String              @unique
  vendorId       String
  status         String
  totalAmount    Float               @default(0)
  expectedDate   DateTime?
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  goodsReceipts  GoodsReceipt[]
  vendor         Vendor              @relation(fields: [vendorId], references: [id])
  items          PurchaseOrderItem[]
  vendorInvoices VendorInvoice[]
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  itemId          String
  quantity        Int
  unitPrice       Float
  totalPrice      Float
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  item            InventoryItem @relation(fields: [itemId], references: [id])
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
}

model InventoryMovement {
  id        String        @id @default(uuid())
  itemId    String
  type      String
  quantity  Int
  notes     String?
  createdAt DateTime      @default(now())
  item      InventoryItem @relation(fields: [itemId], references: [id])
}

model GoodsReceipt {
  id              String        @id @default(uuid())
  purchaseOrderId String
  receivedDate    DateTime      @default(now())
  notes           String?
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
}

model VendorInvoice {
  id              String        @id @default(uuid())
  purchaseOrderId String
  invoiceNumber   String
  amount          Float
  receivedDate    DateTime      @default(now())
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
}

model Employee {
  id               String            @id @default(uuid())
  userId           String?           @unique
  firstName        String
  lastName         String
  email            String            @unique
  phone            String?
  department       String
  position         String
  baseSalary       Float
  hireDate         DateTime          @db.Date
  status           String            @default("ACTIVE")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  attendance       Attendance[]
  user             User?             @relation(fields: [userId], references: [id])
  leaves           LeaveRequest[]
  payrollLineItems PayrollLineItem[]
  payrolls         PayrollRecord[]
  shifts           Shift[]
  tasks            Task[]            @relation("EmployeeTasks")
}

model Shift {
  id         String   @id @default(uuid())
  employeeId String
  startTime  DateTime
  endTime    DateTime
  role       String?
  status     String   @default("SCHEDULED")
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employee   Employee @relation(fields: [employeeId], references: [id])
}

model LeaveRequest {
  id         String   @id @default(uuid())
  employeeId String
  type       String
  startDate  DateTime @db.Date
  endDate    DateTime @db.Date
  reason     String?
  status     String   @default("PENDING")
  approvedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employee   Employee @relation(fields: [employeeId], references: [id])
}

model PayrollRecord {
  id             String    @id @default(uuid())
  employeeId     String
  periodStart    DateTime  @db.Date
  periodEnd      DateTime  @db.Date
  baseAmount     Float
  overtimeAmount Float     @default(0)
  deductions     Float     @default(0)
  bonuses        Float     @default(0)
  netPay         Float
  status         String    @default("DRAFT")
  paidAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  employee       Employee  @relation(fields: [employeeId], references: [id])
}

model Attendance {
  id         String    @id @default(uuid())
  employeeId String
  date       DateTime  @db.Date
  clockIn    DateTime
  clockOut   DateTime?
  status     String    @default("PRESENT")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  employee   Employee  @relation(fields: [employeeId], references: [id])
}

model PayrollRun {
  id          String            @id @default(uuid())
  periodStart DateTime          @db.Date
  periodEnd   DateTime          @db.Date
  status      String            @default("DRAFT")
  totalAmount Float             @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  lineItems   PayrollLineItem[]
}

model PayrollLineItem {
  id           String     @id @default(uuid())
  payrollRunId String
  employeeId   String
  basePay      Float
  overtimePay  Float      @default(0)
  deductions   Float      @default(0)
  netPay       Float
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  employee     Employee   @relation(fields: [employeeId], references: [id])
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id])
}

model Asset {
  id                    String                 @id @default(uuid())
  name                  String
  category              String
  location              String
  serialNumber          String?
  installationDate      DateTime?              @db.Date
  warrantyExpiry        DateTime?              @db.Date
  status                String                 @default("OPERATIONAL")
  notes                 String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  inspections           InspectionLog[]
  schedules             MaintenanceSchedule[]
  maintenanceWorkOrders MaintenanceWorkOrder[]
}

model MaintenanceSchedule {
  id             String    @id @default(uuid())
  assetId        String
  taskName       String
  frequencyDays  Int
  lastRun        DateTime? @db.Date
  nextRun        DateTime  @db.Date
  assignedToRole String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  asset          Asset     @relation(fields: [assetId], references: [id])
}

model InspectionLog {
  id             String   @id @default(uuid())
  assetId        String
  technicianName String
  inspectionDate DateTime @default(now())
  status         String
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  asset          Asset    @relation(fields: [assetId], references: [id])
}

model MaintenanceWorkOrder {
  id        String   @id @default(uuid())
  roomId    String?
  assetId   String?
  issue     String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  asset     Asset?   @relation(fields: [assetId], references: [id])
  room      Room?    @relation(fields: [roomId], references: [id])
}

model OutOfOrderRecord {
  id        String   @id @default(uuid())
  roomId    String
  reason    String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  createdAt DateTime @default(now())
  room      Room     @relation(fields: [roomId], references: [id])
}

model Property {
  id           String    @id @default(uuid())
  name         String
  code         String    @unique
  address      String
  city         String
  country      String
  timezone     String    @default("UTC")
  businessDate DateTime  @default(now()) @db.Date
  totalRooms   Int       @default(0)
  status       String    @default("ACTIVE")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  bookings     Booking[]
  folios       Folio[]
  rooms        Room[]
  tasks        Task[]
  users        User[]
}

model GuestConversation {
  id            String         @id @default(uuid())
  guestId       String
  status        String         @default("OPEN")
  aiEnabled     Boolean        @default(true)
  lastMessageAt DateTime       @default(now())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  guest         User           @relation(fields: [guestId], references: [id])
  messages      GuestMessage[]
}

model GuestMessage {
  id             String            @id @default(uuid())
  conversationId String
  senderType     String
  content        String
  isRead         Boolean           @default(false)
  createdAt      DateTime          @default(now())
  conversation   GuestConversation @relation(fields: [conversationId], references: [id])
}

model Integration {
  id        String   @id @default(uuid())
  appName   String   @unique
  provider  String
  status    String   @default("INACTIVE")
  apiKey    String?
  config    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WebhookEndpoint {
  id            String                @id @default(uuid())
  url           String
  event         String
  isActive      Boolean               @default(true)
  secret        String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  deliveries    WebhookDelivery[]
  subscriptions WebhookSubscription[]
}

model WebhookDelivery {
  id                String          @id @default(uuid())
  webhookEndpointId String
  payload           Json
  status            String          @default("PENDING")
  statusCode        Int?
  attempts          Int             @default(0)
  createdAt         DateTime        @default(now())
  webhookEndpoint   WebhookEndpoint @relation(fields: [webhookEndpointId], references: [id])
}

model WebhookSubscription {
  id                String          @id @default(uuid())
  webhookEndpointId String
  eventTypes        String[]
  createdAt         DateTime        @default(now())
  webhookEndpoint   WebhookEndpoint @relation(fields: [webhookEndpointId], references: [id])
}

model ResortFacility {
  id             String          @id @default(uuid())
  name           String
  type           String
  operatingHours String          @default("09:00-18:00")
  status         String          @default("ACTIVE")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  bookings       ResortBooking[]
  services       ResortService[]
}

model ResortService {
  id           String         @id @default(uuid())
  facilityId   String
  name         String
  durationMins Int
  price        Float
  createdAt    DateTime       @default(now())
  facility     ResortFacility @relation(fields: [facilityId], references: [id])
}

model ResortBooking {
  id         String         @id @default(uuid())
  facilityId String
  guestId    String
  startTime  DateTime
  endTime    DateTime
  status     String         @default("CONFIRMED")
  notes      String?
  createdAt  DateTime       @default(now())
  facility   ResortFacility @relation(fields: [facilityId], references: [id])
  guest      User           @relation(fields: [guestId], references: [id])
}

model Incident {
  id                  String   @id @default(uuid())
  title               String
  category            String
  severity            String
  status              String   @default("OPEN")
  owner               String
  slaMinutesRemaining Int
  message             String
  notes               String   @default("")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model InternalOrder {
  id              String              @id @default(uuid())
  orderType       String              @default("IN_ROOM_DINING")
  status          String
  totalAmount     Float
  guestId         String?
  roomId          String?
  outletId        String?
  folioId         String?
  paymentType     String?
  specialRequests String?
  deliveryTime    DateTime?
  idempotencyKey  String?             @unique
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  folio           Folio?              @relation(fields: [folioId], references: [id])
  guest           User?               @relation("GuestInternalOrders", fields: [guestId], references: [id])
  outlet          POSOutlet?          @relation(fields: [outletId], references: [id])
  room            Room?               @relation(fields: [roomId], references: [id])
  items           InternalOrderItem[]
  payments        Payment[]

  @@index([guestId])
  @@index([orderType, createdAt])
}

model InternalOrderItem {
  id         String        @id @default(uuid())
  orderId    String
  productId  String?
  menuItemId String?
  quantity   Int
  price      Float
  subtotal   Float
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  menuItem   FoodMenu?     @relation(fields: [menuItemId], references: [id])
  order      InternalOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    POSProduct?   @relation(fields: [productId], references: [id])
}

model Feedback {
  id                String   @id @default(uuid())
  userId            String
  targetType        String   @default("HOTEL")
  rating            Int      @default(5)
  overallRating     Int      @default(5)
  serviceRating     Int?
  cleanlinessRating Int?
  valueRating       Int?
  title             String?
  comment           String?
  verified          Boolean  @default(false)
  createdAt         DateTime @default(now())
  roomId            String?
  bookingId         String?
  booking           Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  room              Room?    @relation(fields: [roomId], references: [id])
  user              User     @relation(fields: [userId], references: [id])
}

model WebhookDLQ {
  id         String    @id @default(uuid())
  provider   String
  payload    Json
  error      String?
  resolved   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  DIRTY
  CLEANING
  INSPECTION_PENDING
  MAINTENANCE
  OUT_OF_ORDER
}

enum StayStatus {
  EXPECTED
  CHECKED_IN
  CHECKED_OUT
  NO_SHOW
}

enum EventStatus {
  upcoming
  ongoing
  completed
  cancelled
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum BookingSource {
  WALK_IN
  WEBSITE
  BOOKING_COM
  AGODA
  EXPEDIA
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
  unpaid
  partial
}

enum PaymentMethod {
  cash
  card
  bank_transfer
  crypto
  other
}

enum TaskType {
  HOUSEKEEPING
  MAINTENANCE
  ROOM_SERVICE
  GUEST_REQUEST
  ADMINISTRATIVE
}

enum TaskStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  VERIFIED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum LoyaltyTransactionType {
  earned
  spent
  expired
}
