generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// PROPERTY STRUCTURE
// ==========================================

model RoomType {
  id           String   @id @default(uuid())
  name         String   @unique
  description  String
  baseRate     Float
  capacity     Int      @default(2)
  amenities    String[]
  images       String[]
  totalRooms   Int      @default(0)
  otaMappingId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rooms Room[]
  groupBlocks GroupBlock[]
}

model Room {
  id                 String     @id @default(uuid())
  version            Int        @default(1)
  number             String     @unique
  floor              Int
  capacity           Int        @default(2)
  size               Int        @default(25)
  roomTypeId         String
  status             RoomStatus @default(AVAILABLE)
  lastStatusChangeAt DateTime?  @default(now())
  lockId             String?
  lockExpiresAt      DateTime?
  lastCleanedAt      DateTime?
  lastInspectedAt    DateTime?
  deletedAt          DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  roomType      RoomType             @relation(fields: [roomTypeId], references: [id])
  bookings      Booking[]
  tasks         Task[]
  statusHistory RoomStatusHistory[]
  maintenance   MaintenanceRequest[]
  roomImages    RoomImage[]
  reviews       RoomReview[]

  @@index([status])
  @@index([roomTypeId])
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  DIRTY
  CLEANING
  INSPECTION_PENDING
  MAINTENANCE
  OUT_OF_ORDER
}

model RoomStatusHistory {
  id        String     @id @default(uuid())
  roomId    String
  oldStatus RoomStatus
  newStatus RoomStatus
  actorId   String
  reason    String?
  createdAt DateTime   @default(now())

  room Room @relation(fields: [roomId], references: [id])
}

model RoomImage {
  id           String   @id @default(uuid())
  roomId       String
  imageUrl     String
  isMain       Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  room Room @relation(fields: [roomId], references: [id])
}

// ==========================================
// BOOKING & GUESTS
// ==========================================

model Booking {
  id               String        @id @default(uuid())
  version          Int           @default(1)
  confirmationCode String        @unique
  checkIn          DateTime      @db.Date
  checkOut         DateTime      @db.Date
  status           BookingStatus @default(CONFIRMED)
  source           BookingSource @default(WEBSITE)
  otaReference     String?

  roomId         String
  primaryGuestId String

  guests          Int           @default(1)
  totalAmount     Float
  paymentStatus   PaymentStatus @default(unpaid)
  paymentMethod   String?
  paymentProvider String?

  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room             Room           @relation(fields: [roomId], references: [id])
  guest            User           @relation("PrimaryGuest", fields: [primaryGuestId], references: [id])
  additionalGuests BookingGuest[]
  invoices         Invoice[]
  payments         Payment[]
  tasks            Task[]
  roomReviews      RoomReview[]
  complaints       Complaint[]

  @@index([checkIn, checkOut])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([roomId, status])
}

model Event {
  id          String      @id @default(uuid())
  name        String
  description String?
  eventDate   DateTime
  startTime   String?
  endTime     String?
  location    String?
  capacity    Int?
  category    String?
  status      EventStatus @default(upcoming)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([eventDate])
  @@index([status])
}

enum EventStatus {
  upcoming
  ongoing
  completed
  cancelled
}

model BookingGuest {
  id        String  @id @default(uuid())
  bookingId String
  userId    String?
  name      String
  email     String?
  phone     String?
  identity  String?
  isMinor   Boolean @default(false)

  booking Booking @relation(fields: [bookingId], references: [id])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum BookingSource {
  WALK_IN
  WEBSITE
  BOOKING_COM
  AGODA
  EXPEDIA
}

// ==========================================
// FINANCIALS
// ==========================================

model Invoice {
  id         String   @id @default(uuid())
  invoiceNo  String   @unique
  bookingId  String
  subtotal   Float
  taxAmount  Float
  grandTotal Float
  status     String
  deletedAt  DateTime?
  folioType  String   @default("MASTER")
  routingRules Json?
  isLocked   Boolean  @default(false)
  issuedAt   DateTime @default(now())
  updatedAt  DateTime @updatedAt

  booking   Booking           @relation(fields: [bookingId], references: [id])
  lineItems InvoiceLineItem[]
  posOrders POSOrder[]
}

model InvoiceLineItem {
  id          String @id @default(uuid())
  invoiceId   String
  description String
  quantity    Int
  unitPrice   Float
  totalPrice  Float
  category    String

  invoice Invoice @relation(fields: [invoiceId], references: [id])
}

model JournalEntry {
  id            String   @id @default(uuid())
  transactionId String?
  accountId     String
  debit         Float    @default(0)
  credit        Float    @default(0)
  description   String
  postingDate   DateTime @db.Date
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model NightAuditLog {
  id              String   @id @default(uuid())
  businessDate    DateTime @db.Date
  totalRevenue    Float
  roomsProcessed  Int
  status          String   @default("COMPLETED")
  runByUserId     String?
  createdAt       DateTime @default(now())

  user            User?    @relation(fields: [runByUserId], references: [id])
}

model Payment {
  id              String        @id @default(uuid())
  bookingId       String?
  orderId         String?
  userId          String?
  amount          Float
  currency        String        @default("LKR")
  paymentMethod   PaymentMethod @default(card)
  paymentProvider String?
  providerId      String?       @unique
  status          PaymentStatus @default(pending)
  capturedAt      DateTime?
  refundedAt      DateTime?
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  booking     Booking?              @relation(fields: [bookingId], references: [id])
  order       FoodOrder?            @relation(fields: [orderId], references: [id])
  user        User?                 @relation(fields: [userId], references: [id])
  adjustments FinancialAdjustment[]

  @@index([createdAt])
  @@index([status])
}

model FinancialAdjustment {
  id        String   @id @default(uuid())
  paymentId String
  type      String
  amount    Float
  reason    String
  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
  unpaid
  partial
}

enum PaymentMethod {
  cash
  card
  bank_transfer
  crypto
  other
}

// ==========================================
// OPERATIONS
// ==========================================

model Task {
  id          String     @id @default(uuid())
  version     Int        @default(1)
  type        TaskType
  status      TaskStatus @default(PENDING)
  priority    Priority   @default(MEDIUM)
  title       String
  description String?
  assignedTo  String?
  roomId      String?
  bookingId   String?
  createdBy   String?
  dueDate     DateTime?

  assignedStaff Staff? @relation("StaffTasks", fields: [assignedTo], references: [id])
  creator       User?  @relation("CreatedTasks", fields: [createdBy], references: [id])

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  acceptedAt     DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  verifiedAt     DateTime?
  elapsedMinutes Int?

  room    Room?    @relation(fields: [roomId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])
}

enum TaskType {
  HOUSEKEEPING
  MAINTENANCE
  ROOM_SERVICE
  GUEST_REQUEST
  ADMINISTRATIVE
}

enum TaskStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  VERIFIED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model MaintenanceRequest {
  id          String              @id @default(uuid())
  roomId      String?
  userId      String
  assignedTo  String?
  title       String
  description String
  category    String
  priority    MaintenancePriority @default(medium)
  status      MaintenanceStatus   @default(pending)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  room Room? @relation(fields: [roomId], references: [id])
}

enum MaintenancePriority {
  low
  medium
  high
  urgent
}

enum MaintenanceStatus {
  pending
  in_progress
  completed
  cancelled
}

// ==========================================
// KITCHEN & ROOM SERVICE
// ==========================================

model FoodOrder {
  id              String    @id @default(uuid())
  guestId         String
  roomNumber      String
  idempotencyKey  String?   @unique
  status          String
  totalAmount     Float
  specialRequests String?
  deliveryTime    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  items    OrderItem[]
  payments Payment[]
  guest    User        @relation("GuestOrders", fields: [guestId], references: [id])
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  menuItemId String
  quantity   Int
  price      Float
  subtotal   Float
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  order    FoodOrder @relation(fields: [orderId], references: [id])
  menuItem FoodMenu  @relation(fields: [menuItemId], references: [id])
}

model YieldRule {
  id              String   @id @default(uuid())
  name            String
  description     String?
  startDate       DateTime @db.Date
  endDate         DateTime @db.Date
  adjustmentType  String   // 'PERCENTAGE' or 'FIXED'
  adjustmentValue Float
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ==========================================
// ENTERPRISE POS (RESTAURANT, BAR, SPA)
// ==========================================

model POSOutlet {
  id          String   @id @default(uuid())
  name        String
  type        String   // RESTAURANT, BAR, SPA, RETAIL
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    POSProduct[]
  orders      POSOrder[]
}

model POSProduct {
  id          String   @id @default(uuid())
  outletId    String
  name        String
  category    String
  price       Float
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  outlet      POSOutlet @relation(fields: [outletId], references: [id])
  orderItems  POSOrderItem[]
}

model POSOrder {
  id          String   @id @default(uuid())
  outletId    String
  invoiceId   String?  // If charged to room
  status      String   // PENDING, COMPLETED, CANCELLED
  totalAmount Float
  paymentType String   // CASH, CARD, ROOM_CHARGE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  outlet      POSOutlet @relation(fields: [outletId], references: [id])
  invoice     Invoice?  @relation(fields: [invoiceId], references: [id])
  items       POSOrderItem[]
}

model POSOrderItem {
  id          String   @id @default(uuid())
  orderId     String
  productId   String
  quantity    Int
  price       Float
  subtotal    Float

  order       POSOrder   @relation(fields: [orderId], references: [id])
  product     POSProduct @relation(fields: [productId], references: [id])
}

// ==========================================
// EVENTS & BANQUETING (PHASE 6)
// ==========================================

model EventSpace {
  id          String   @id @default(uuid())
  name        String
  capacity    Int
  hourlyRate  Float
  dailyRate   Float
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookings    EventBooking[]
}

model BanquetingEvent {
  id                String   @id @default(uuid())
  name              String
  type              String   // CONFERENCE, WEDDING, MEETING
  status            String   // PROSPECT, TENTATIVE, DEFINITE, CANCELLED
  startDate         DateTime @db.Date
  endDate           DateTime @db.Date
  expectedAttendees Int
  organizerName     String
  organizerEmail    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  spaceBookings     EventBooking[]
  groupBlocks       GroupBlock[]
}

model EventBooking {
  id          String   @id @default(uuid())
  eventId     String
  spaceId     String
  startTime   DateTime
  endTime     DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event       BanquetingEvent @relation(fields: [eventId], references: [id])
  space       EventSpace      @relation(fields: [spaceId], references: [id])
}

model GroupBlock {
  id             String   @id @default(uuid())
  eventId        String
  roomTypeId     String
  blockedCount   Int
  contractedRate Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  event          BanquetingEvent @relation(fields: [eventId], references: [id])
  roomType       RoomType        @relation(fields: [roomTypeId], references: [id])
}

model FoodMenu {
  id              String      @id @default(uuid())
  name            String
  description     String
  category        String
  price           Float
  available       Boolean     @default(true)
  preparationTime Int
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  orderItems      OrderItem[]
}

// ==========================================
// USERS & GUESTS
// ==========================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  phone     String?
  password  String
  role      UserRole @default(GUEST)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vipStatus          String    @default("STANDARD")
  blacklistStatus    Boolean   @default(false)
  blacklistReason    String?
  corporateAccountId String?
  travelAgentId      String?

  corporateAccount   CorporateAccount? @relation(fields: [corporateAccountId], references: [id])
  travelAgent        TravelAgent?      @relation(fields: [travelAgentId], references: [id])
  guestHistory       GuestHistory?

  guestBookings    Booking[]        @relation("PrimaryGuest")
  loyalty          LoyaltyPoint?
  staffProfile     Staff?
  guestPreferences GuestPreference?
  reviews          RoomReview[]
  hotelReviews     HotelReview[]
  tableBookings    TableBooking[]
  complaints       Complaint[]
  foodOrders       FoodOrder[]      @relation("GuestOrders")
  payments         Payment[]
  notifications    Notification[]
  createdTasks     Task[]           @relation("CreatedTasks")
  auditLogs        AuditLog[]
  nightAuditsRun   NightAuditLog[]
}

model GuestPreference {
  id                  String   @id @default(uuid())
  userId              String   @unique
  dietaryRestrictions String[]
  allergies           String[]
  roomPreferences     String[]
  user                User     @relation(fields: [userId], references: [id])
}

model CorporateAccount {
  id              String   @id @default(uuid())
  companyName     String   @unique
  contactName     String
  contactEmail    String
  contactPhone    String
  negotiatedRate  Float?   
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users           User[]
}

model TravelAgent {
  id              String   @id @default(uuid())
  agencyName      String   @unique
  iataNumber      String?
  contactName     String
  contactEmail    String
  contactPhone    String
  commissionRate  Float    @default(10.0) 
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users           User[]
}

model GuestHistory {
  id              String   @id @default(uuid())
  userId          String   @unique
  totalStays      Int      @default(0)
  totalNights     Int      @default(0)
  totalSpend      Float    @default(0)
  lastStayDate    DateTime?
  lastRoomTypeId  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id])
}

model Staff {
  id         String   @id @default(uuid())
  userId     String   @unique
  employeeId String   @unique
  name       String
  email      String?
  phone      String?
  position   String
  department String
  hireDate   DateTime @default(now())
  salary     Float    @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tasks Task[] @relation("StaffTasks")
  user  User   @relation(fields: [userId], references: [id])
}

enum UserRole {
  SUPER_ADMIN
  MANAGER
  RECEPTIONIST
  HOUSEKEEPING
  MAINTENANCE
  KITCHEN
  GUEST
}

// ==========================================
// FEEDBACK
// ==========================================

model RoomReview {
  id        String   @id @default(uuid())
  roomId    String
  userId    String
  bookingId String?
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  room    Room     @relation(fields: [roomId], references: [id])
  user    User     @relation(fields: [userId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])
}

model HotelReview {
  id                String   @id @default(uuid())
  userId            String
  rating            Int      @default(5) // Legacy compatibility (mapped to overall)
  overallRating     Int      @default(5)
  serviceRating     Int?
  cleanlinessRating Int?
  valueRating       Int?
  title             String?
  comment           String?
  verified          Boolean  @default(false)
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Amenity {
  id           String   @id @default(uuid())
  name         String   @unique
  description  String?
  category     String?
  icon         String?
  active       Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Knowledge {
  id        String   @id @default(uuid())
  category  String?
  content   String
  embedding Float[]
  metadata  Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

model EmbeddingCache {
  id        String   @id @default(uuid())
  text      String   @unique
  embedding Float[]
  model     String   @default("nomic-embed-text-v1_5")
  createdAt DateTime @default(now())
}

// ==========================================
// INFRA & OTA
// ==========================================

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  link      String?
  read      Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
}

model Outbox {
  id          String    @id @default(uuid())
  topic       String
  payload     Json
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())
  processedAt DateTime?
}

model SyncLog {
  id           String   @id @default(uuid())
  direction    String
  status       String
  entityType   String
  entityId     String?
  payload      Json?
  errorMessage String?
  attempts     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  actor      String
  action     String
  resource   String
  resourceId String?
  details    Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model ChannelConfig {
  id         String  @id @default(uuid())
  provider   String
  apiKey     String
  propertyId String
  isEnabled  Boolean @default(true)
}

model RoomMapping {
  id                    String  @id @default(uuid())
  localRoomTypeId       String
  otaRoomTypeId         String
  otaRatePlanId         String?
  priceMarkupPercentage Float   @default(15.0)
  syncEnabled           Boolean @default(true)
}

// ==========================================
// CHAT & AI
// ==========================================

model Gallery {
  id        String   @id @default(uuid())
  title     String
  imageUrl  String
  category  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

model HeroSlide {
  id          String   @id @default(uuid())
  image       String
  title       String
  subtitle    String
  description String
  cta         String
  ctaLink     String
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, order])
}

model Inventory {
  id          String   @id @default(uuid())
  name        String
  description String?
  category    String
  quantity    BigInt   @default(0)
  unit        String
  minQuantity BigInt   @default(0)
  status      String   @default("IN_STOCK")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([status])
}

model LoyaltyPoint {
  id          String   @id @default(uuid())
  userId      String   @unique
  points      Int      @default(0)
  totalEarned Int      @default(0)
  totalSpent  Int      @default(0)
  tier        String   @default("SILVER")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User                 @relation(fields: [userId], references: [id])
  transactions LoyaltyTransaction[]
}

model LoyaltyTransaction {
  id             String                 @id @default(uuid())
  loyaltyPointId String
  type           LoyaltyTransactionType
  points         Int
  description    String
  referenceId    String?
  createdAt      DateTime               @default(now())

  loyaltyPoint LoyaltyPoint @relation(fields: [loyaltyPointId], references: [id])

  @@index([loyaltyPointId])
}

enum LoyaltyTransactionType {
  earned
  spent
  expired
}

model NavigationLink {
  id        String     @id @default(uuid())
  name      String
  href      String
  icon      String?
  order     Int        @default(0)
  active    Boolean    @default(true)
  roles     UserRole[] @default([])
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([active, order])
}

model Conversation {
  id        String   @id @default(uuid())
  sessionId String
  userId    String
  message   String
  response  String
  timestamp DateTime @default(now())

  @@index([sessionId])
  @@index([userId])
}

model ChatCustomer {
  id          String   @id @default(uuid())
  phone       String   @unique
  name        String?
  lastOrderId String?
  preferences Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SocialLink {
  id        String   @id @default(uuid())
  platform  String
  url       String
  icon      String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, order])
}

model TableBooking {
  id              String   @id @default(uuid())
  userId          String?
  name            String
  email           String
  phone           String
  guests          Int
  bookingDate     DateTime
  bookingTime     String
  status          String   @default("PENDING")
  specialRequests String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id])
}

model Complaint {
  id          String    @id @default(uuid())
  userId      String
  bookingId   String?
  subject     String
  description String
  category    String
  status      String    @default("OPEN")
  priority    Priority  @default(MEDIUM)
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user    User     @relation(fields: [userId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])
}

model Testimonial {
  id        String   @id @default(uuid())
  name      String
  role      String?
  content   String
  rating    Int      @default(5)
  image     String?
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model FooterLink {
  id        String   @id @default(uuid())
  label     String
  url       String
  category  String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([active, order])
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("UNREAD") // UNREAD, READ, REPLIED, ARCHIVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([status])
}

model FAQ {
  id        String   @id @default(uuid())
  question  String
  answer    String
  category  String   @default("General")
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([active, order])
}

// ==========================================
// PROCUREMENT & INVENTORY (PHASE 9)
// ==========================================

model Vendor {
  id            String          @id @default(uuid())
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  items         InventoryItem[]
  purchaseOrders PurchaseOrder[]
}

model InventoryItem {
  id              String           @id @default(uuid())
  name            String
  sku             String?          @unique
  category        String           // FOOD, BEVERAGE, LINEN, MAINTENANCE
  unit            String           // KG, LITER, PIECE, BOX
  unitPrice       Float
  parLevel        Int              @default(10) // Reorder threshold
  vendorId        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  vendor          Vendor?          @relation(fields: [vendorId], references: [id])
  stocks          InventoryStock[]
  purchaseItems   PurchaseOrderItem[]
}

model InventoryStock {
  id              String        @id @default(uuid())
  itemId          String
  location        String        // MAIN_STORE, KITCHEN, BAR, HOUSEKEEPING
  quantity        Int           @default(0)
  lastCountedAt   DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  item            InventoryItem @relation(fields: [itemId], references: [id])

  @@unique([itemId, location])
}

model PurchaseOrder {
  id              String              @id @default(uuid())
  orderNumber     String              @unique
  vendorId        String
  status          String              // DRAFT, PENDING_APPROVAL, APPROVED, DELIVERED, CANCELLED
  totalAmount     Float               @default(0)
  expectedDate    DateTime?
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  vendor          Vendor              @relation(fields: [vendorId], references: [id])
  items           PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  itemId          String
  quantity        Int
  unitPrice       Float
  totalPrice      Float
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  item            InventoryItem @relation(fields: [itemId], references: [id])
}
