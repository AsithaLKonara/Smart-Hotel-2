generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ==========================================
// PROPERTY STRUCTURE
// ==========================================

model RoomType {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  name                  String   @unique 
  description           String
  baseRate              Float
  capacity              Int      @default(2)
  amenities             String[]
  images                String[]
  totalRooms            Int      @default(0)
  otaMappingId          String?  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  rooms                 Room[]
}

model Room {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  version         Int              @default(1) 
  number          String           @unique
  floor           Int
  roomTypeId      String           @db.ObjectId
  status          RoomStatus       @default(AVAILABLE)
  lastCleanedAt   DateTime?
  lastInspectedAt DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  
  roomType        RoomType         @relation(fields: [roomTypeId], references: [id])
  bookings        Booking[]
  tasks           Task[]
  statusHistory   RoomStatusHistory[]
  maintenance     MaintenanceRequest[]
  roomImages      RoomImage[]
  reviews         RoomReview[]

  @@index([status])
  @@index([roomTypeId])
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  DIRTY
  CLEANING
  INSPECTION_PENDING
  MAINTENANCE
  OUT_OF_ORDER
}

model RoomStatusHistory {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  roomId    String     @db.ObjectId
  oldStatus RoomStatus
  newStatus RoomStatus
  actorId   String     @db.ObjectId
  reason    String?
  createdAt DateTime   @default(now())
  
  room      Room       @relation(fields: [roomId], references: [id])
}

model RoomImage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  roomId    String   @db.ObjectId
  imageUrl  String
  room      Room     @relation(fields: [roomId], references: [id])
}

// ==========================================
// BOOKING & GUESTS
// ==========================================

model Booking {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
  version          Int              @default(1)
  confirmationCode String           @unique
  checkIn          DateTime         @db.Date
  checkOut         DateTime         @db.Date
  status           BookingStatus    @default(CONFIRMED)
  source           BookingSource    @default(WEBSITE)
  otaReference     String?
  
  roomId           String           @db.ObjectId
  primaryGuestId   String           @db.ObjectId
  
  totalAmount      Float
  paymentStatus    PaymentStatus    @default(UNPAID)
  
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  
  room             Room             @relation(fields: [roomId], references: [id])
  guest            User             @relation("PrimaryGuest", fields: [primaryGuestId], references: [id])
  additionalGuests BookingGuest[]
  invoices         Invoice[]
  payments         Payment[]
  tasks            Task[]
  roomReviews      RoomReview[]
  
  @@index([checkIn, checkOut])
  @@index([status])
}

model BookingGuest {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  bookingId String   @db.ObjectId
  userId    String?  @db.ObjectId 
  name      String
  email     String?
  phone     String?
  identity  String?  
  isMinor   Boolean  @default(false)
  
  booking   Booking  @relation(fields: [bookingId], references: [id])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum BookingSource {
  WALK_IN
  WEBSITE
  BOOKING_COM
  AGODA
  EXPEDIA
}

// ==========================================
// FINANCIALS
// ==========================================

model Invoice {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  invoiceNo   String   @unique
  bookingId   String   @db.ObjectId
  subtotal    Float
  taxAmount   Float
  grandTotal  Float
  status      String   
  issuedAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  booking     Booking  @relation(fields: [bookingId], references: [id])
  lineItems   InvoiceLineItem[]
}

model InvoiceLineItem {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  invoiceId   String   @db.ObjectId
  description String
  quantity    Int
  unitPrice   Float
  totalPrice  Float
  category    String   
  
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
}

model Payment {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  bookingId       String?       @db.ObjectId
  orderId         String?       @db.ObjectId
  amount          Float
  currency        String        @default("LKR")
  method          PaymentMethod
  provider        String?       
  providerId      String?       @unique
  status          PaymentStatus @default(PENDING)
  capturedAt      DateTime?
  refundedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  booking         Booking?      @relation(fields: [bookingId], references: [id])
  order           FoodOrder?    @relation(fields: [orderId], references: [id])
  adjustments     FinancialAdjustment[]
}

model FinancialAdjustment {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  paymentId   String   @db.ObjectId
  type        String   
  amount      Float
  reason      String
  createdAt   DateTime @default(now())
  
  payment     Payment  @relation(fields: [paymentId], references: [id])
}

enum PaymentStatus {
  UNPAID
  PENDING
  PARTIAL
  PAID
  REFUNDED
  FAILED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
}

// ==========================================
// OPERATIONS
// ==========================================

model Task {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  version         Int         @default(1)
  type            TaskType
  status          TaskStatus  @default(PENDING)
  priority        Priority    @default(MEDIUM)
  title           String
  description     String?
  assignedTo      String?     @db.ObjectId
  roomId          String?     @db.ObjectId
  bookingId       String?     @db.ObjectId
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  acceptedAt      DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  verifiedAt      DateTime?
  elapsedMinutes  Int?
  
  room            Room?       @relation(fields: [roomId], references: [id])
  booking         Booking?    @relation(fields: [bookingId], references: [id])
  staff           Staff?      @relation(fields: [assignedTo], references: [id])
}

enum TaskType {
  HOUSEKEEPING
  MAINTENANCE
  ROOM_SERVICE
  GUEST_REQUEST
}

enum TaskStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  VERIFIED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model MaintenanceRequest {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  roomId      String    @db.ObjectId
  userId      String    @db.ObjectId
  title       String
  description String
  priority    String    
  status      String    
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  room        Room      @relation(fields: [roomId], references: [id])
}

// ==========================================
// KITCHEN & ROOM SERVICE
// ==========================================

model FoodOrder {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  guestId         String      @db.ObjectId
  roomNumber      String
  status          String      
  totalAmount     Float
  specialRequests String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  items           OrderItem[]
  payments        Payment[]
  guest           User        @relation("GuestOrders", fields: [guestId], references: [id])
}

model OrderItem {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  orderId    String    @db.ObjectId
  menuItemId String    @db.ObjectId
  quantity   Int
  price      Float
  subtotal   Float
  notes      String?
  
  order      FoodOrder @relation(fields: [orderId], references: [id])
  menuItem   FoodMenu  @relation(fields: [menuItemId], references: [id])
}

model FoodMenu {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  description     String
  category        String
  price           Float
  available       Boolean     @default(true)
  preparationTime Int         
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  orderItems      OrderItem[]
}

// ==========================================
// USERS & GUESTS
// ==========================================

model User {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
  email            String           @unique
  name             String
  password         String
  role             UserRole         @default(GUEST)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  
  guestBookings    Booking[]        @relation("PrimaryGuest")
  loyalty          LoyaltyAccount?
  staffProfile     Staff?
  guestPreferences GuestPreference?
  reviews          RoomReview[]
  hotelReviews     HotelReview[]
  foodOrders       FoodOrder[]      @relation("GuestOrders")
  notifications    Notification[]
}

model LoyaltyAccount {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @unique @db.ObjectId
  tier      String   @default("SILVER") 
  points    Int      @default(0)
  user      User     @relation(fields: [userId], references: [id])
}

model GuestPreference {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  userId              String   @unique @db.ObjectId
  dietaryRestrictions String[]
  allergies           String[]
  roomPreferences     String[]
  user                User     @relation(fields: [userId], references: [id])
}

model Staff {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  userId     String    @unique @db.ObjectId
  employeeId String    @unique
  position   String
  department String
  isActive   Boolean   @default(true)
  
  tasks      Task[]
  user       User      @relation(fields: [userId], references: [id])
}

enum UserRole {
  SUPER_ADMIN
  MANAGER
  RECEPTIONIST
  HOUSEKEEPING
  MAINTENANCE
  KITCHEN
  GUEST
}

// ==========================================
// FEEDBACK
// ==========================================

model RoomReview {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  roomId    String   @db.ObjectId
  userId    String   @db.ObjectId
  bookingId String?  @db.ObjectId
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  
  room      Room     @relation(fields: [roomId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  booking   Booking? @relation(fields: [bookingId], references: [id])
}

model HotelReview {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id])
}

// ==========================================
// INFRA & OTA
// ==========================================

model Notification {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  type      String
  title     String
  message   String
  read      Boolean   @default(false)
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
}

model Outbox {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  topic       String
  payload     Json
  status      String   @default("PENDING")
  attempts    Int      @default(0)
  createdAt   DateTime @default(now())
  processedAt DateTime?
}

model SyncLog {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  direction    String   
  status       String   
  entityType   String   
  entityId     String?  
  payload      Json?
  errorMessage String?
  createdAt    DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  actor     String
  action    String
  resource  String
  resourceId String?
  details   Json?
  createdAt DateTime @default(now())
}

model ChannelConfig {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  provider   String   
  apiKey     String
  propertyId String
  isEnabled  Boolean  @default(true)
}

model RoomMapping {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  localRoomTypeId       String   @db.ObjectId
  otaRoomTypeId         String
  priceMarkupPercentage Float    @default(15.0)
  syncEnabled           Boolean  @default(true)
}

// ==========================================
// CHAT & AI
// ==========================================

model Conversation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionId String
  userId    String
  message   String
  response  String
  timestamp DateTime @default(now())

  @@index([sessionId])
  @@index([userId])
}

model ChatCustomer {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  phone       String   @unique
  name        String?
  lastOrderId String?
  preferences Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
